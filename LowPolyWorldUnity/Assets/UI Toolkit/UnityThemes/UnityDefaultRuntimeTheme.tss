@import url("unity-theme://default");

/* ============================================================
   LowPolyWorld カラートークン（ライトモード基準・色の単一管理源）
   ------------------------------------------------------------
   役割ベースのセマンティックトークン。UI の色を変えるときは
   原則このブロックだけを編集する。全 USS は var(--lpw-...) で参照する。
   このテーマは UI_PanelSettings に適用され、全 UIDocument にカスケードする。
   将来ダークモードを足す場合は、ルート要素にクラスを付けて
   .theme-dark { --lpw-... } で同名トークンを上書きする方式を想定。
   ============================================================ */
:root {
    /* — サーフェス（背景） — */
    --lpw-bg-page:        rgb(244, 246, 250);   /* アプリ全体の背景 */
    --lpw-surface:        rgb(255, 255, 255);   /* カード・パネル・モーダル・バー */
    --lpw-surface-sunken: rgb(236, 239, 245);   /* 入力欄・へこんだ領域 */
    --lpw-surface-muted:  rgb(248, 249, 252);   /* わずかに沈めた領域・交互行 */
    --lpw-surface-hover:  rgba(0, 0, 0, 0.04);  /* hover ハイライト */
    --lpw-surface-active: rgba(0, 0, 0, 0.08);  /* active 押下ハイライト */

    /* — オーバーレイ（モーダル背後の暗幕。ライトでも暗いまま） — */
    --lpw-scrim:          rgba(0, 0, 0, 0.45);

    /* — ワールド編集画面専用: 3D ビューが透けるすりガラス風メニュー背景 —
       不透明にしたい場合は alpha を 1.0 にすればよい。 */
    --lpw-editor-panel:   rgba(246, 248, 251, 0.86);  /* タブコンテンツ等の主要メニュー */
    --lpw-editor-bar:     rgba(255, 255, 255, 0.90);  /* ヘッダー・タブバー・ツールバー */

    /* — ボーダー・区切り線 — */
    --lpw-border:         rgb(220, 223, 230);
    --lpw-border-strong:  rgb(198, 202, 211);

    /* — テキスト — */
    --lpw-text:           rgb(28, 30, 38);      /* 主要テキスト */
    --lpw-text-secondary: rgb(88, 94, 110);     /* 補助テキスト */
    --lpw-text-muted:     rgb(140, 146, 160);   /* 弱いテキスト・プレースホルダ */
    --lpw-text-on-accent: rgb(255, 255, 255);   /* アクセント塗りの上の文字（暗いアクセントのため白） */
    --lpw-text-on-status: rgb(255, 255, 255);   /* 濃色塗り（フラッシュ/成功/警告/エラー/暗幕）の上の文字（白） */
    --lpw-icon:           rgb(70, 76, 92);       /* 白シルエットアイコンを明色背景で見せるための暗色ティント */

    /* — アクセント（ティール・青緑・主要アクション。上の文字は白） — */
    --lpw-accent:         rgb(20, 150, 160);
    --lpw-accent-hover:   rgb(14, 128, 138);
    --lpw-accent-text:    rgb(12, 116, 126);    /* リンク・アクセント文字（白背景で可読な深いティール） */
    --lpw-accent-subtle:  rgba(20, 150, 160, 0.12);  /* 薄いティール背景・選択中 */
    --lpw-accent-border:  rgba(20, 150, 160, 0.45);

    /* — ステータス — */
    --lpw-success:        rgb(36, 150, 76);
    --lpw-success-subtle: rgba(36, 150, 76, 0.12);
    --lpw-warning:        rgb(196, 132, 24);
    --lpw-warning-subtle: rgba(196, 132, 24, 0.12);
    --lpw-danger:         rgb(208, 54, 54);
    --lpw-danger-text:    rgb(200, 50, 50);
    --lpw-danger-subtle:  rgba(208, 54, 54, 0.10);

    /* — プレミアム/強調（金） — */
    --lpw-premium:        rgb(190, 145, 30);

    /* — フラッシュトースト（濃色背景＋白文字。彩度は維持） — */
    --lpw-flash-info-bg:    rgba(50, 55, 70, 0.94);
    --lpw-flash-success-bg: rgba(40, 160, 80, 0.95);
    --lpw-flash-warning-bg: rgba(200, 140, 40, 0.95);
    --lpw-flash-error-bg:   rgba(200, 50, 50, 0.95);
}