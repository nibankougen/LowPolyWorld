.safe-area-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: var(--lpw-bg-page);
    position: relative;
}

/* フラッシュメッセージ */
.flash-root {
    position: absolute;
    top: 80px;
    left: 0;
    right: 0;
    align-items: center;
    pointer-events: none;
    z-index: 100;
}

.flash-label {
    color: var(--lpw-text-on-status);
    font-size: 26px;
    padding: 12px 28px;
    border-radius: 22px;
    -unity-font-style: bold;
}

.flash-type-info    { background-color: var(--lpw-flash-info-bg); }
.flash-type-success { background-color: var(--lpw-flash-success-bg); }
.flash-type-warning { background-color: var(--lpw-flash-warning-bg); }
.flash-type-error   { background-color: var(--lpw-flash-error-bg); }

.overlay-hidden { display: none; }

.content-area {
    flex-grow: 1;
}

/* ナビゲーションバー */
.nav-bar {
    flex-direction: row;
    height: 120px;
    background-color: var(--lpw-surface);
    border-top-width: 1px;
    border-top-color: var(--lpw-border);
}

.nav-tab {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding: 8px 4px;
}

.nav-tab:hover {
    background-color: var(--lpw-surface-hover);
}

.nav-tab:active {
    background-color: var(--lpw-surface-active);
}

.nav-tab__icon {
    font-size: 36px;
    color: var(--lpw-text-muted);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.nav-tab__label {
    font-size: 18px;
    color: var(--lpw-text-muted);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* アクティブタブ */
.nav-tab--active .nav-tab__icon,
.nav-tab--active .nav-tab__label {
    color: var(--lpw-accent-text);
}
