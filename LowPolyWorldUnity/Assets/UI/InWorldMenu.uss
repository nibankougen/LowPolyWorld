.menu-backdrop {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: var(--lpw-scrim);
}

.menu-panel {
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: 640px;
    background-color: var(--lpw-surface);
    flex-direction: column;
}

/* ヘッダー */
.menu-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 40px 32px 24px;
    border-bottom-width: 1px;
    border-bottom-color: var(--lpw-border);
}

.menu-title {
    font-size: 36px;
    color: var(--lpw-text);
    -unity-font-style: bold;
}

.menu-close-btn {
    width: 80px;
    height: 80px;
    font-size: 36px;
    background-color: var(--lpw-surface-hover);
    color: var(--lpw-text-secondary);
    border-radius: 40px;
    border-width: 0;
}

.menu-close-btn:active {
    background-color: var(--lpw-surface-active);
    scale: 0.93;
}

/* タブバー */
.menu-tab-bar {
    flex-direction: row;
    padding: 0 16px;
    border-bottom-width: 1px;
    border-bottom-color: var(--lpw-border);
}

.menu-tab {
    flex-grow: 1;
    height: 80px;
    font-size: 24px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--lpw-text-muted);
    border-width: 0;
    border-radius: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0);
}

.menu-tab--active {
    color: var(--lpw-accent-text);
    border-bottom-color: var(--lpw-accent);
}

/* コンテンツ */
.menu-content {
    flex-grow: 1;
}

.menu-tab-content {
    flex-grow: 1;
    padding: 32px;
}

.menu-tab-content--hidden {
    display: none;
}

.menu-stub-text {
    font-size: 28px;
    color: var(--lpw-text-muted);
    -unity-text-align: middle-center;
    flex-grow: 1;
}

/* 設定タブ内 音量コントロール */
.menu-section-title {
    font-size: 26px;
    color: var(--lpw-text-muted);
    margin-bottom: 20px;
    -unity-font-style: bold;
}

.volume-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 24px;
}

.volume-label {
    width: 200px;
    font-size: 24px;
    color: var(--lpw-text-secondary);
}

.volume-slider {
    flex-grow: 1;
    margin-left: 12px;
    margin-right: 12px;
}

.volume-slider > .unity-base-slider__dragger {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: var(--lpw-accent);
    border-width: 0;
    top: -12px;
}

.volume-slider > .unity-base-slider__tracker {
    height: 6px;
    border-radius: 3px;
    background-color: var(--lpw-border);
}

.volume-value {
    width: 80px;
    font-size: 24px;
    color: var(--lpw-accent-text);
    -unity-text-align: middle-right;
}

/* ルームタブ */
.room-world-name {
    font-size: 32px;
    color: var(--lpw-text);
    -unity-font-style: bold;
    margin-bottom: 28px;
}

.room-language-btn {
    font-size: 24px;
    color: var(--lpw-accent-text);
    -unity-font-style: bold;
    background-color: var(--lpw-accent-subtle);
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--lpw-accent-border);
    padding: 4px 20px;
    height: 52px;
}

.room-language-btn:active {
    background-color: var(--lpw-accent-subtle);
}

.room-language-btn--readonly {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.room-reenter-btn {
    height: 80px;
    font-size: 26px;
    color: var(--lpw-text-on-accent);
    background-color: var(--lpw-accent);
    border-radius: 12px;
    border-width: 0;
    margin-top: 8px;
    margin-bottom: 32px;
    -unity-font-style: bold;
}

.room-reenter-btn:active {
    background-color: var(--lpw-accent-hover);
    scale: 0.97;
}

.room-members-title {
    margin-bottom: 12px;
}

.room-members-list {
    flex-grow: 1;
}

.room-member-card {
    flex-direction: row;
    align-items: center;
    background-color: var(--lpw-surface-muted);
    border-radius: 12px;
    padding: 18px 24px;
    margin-bottom: 10px;
}

.room-member-card:active {
    background-color: var(--lpw-surface-active);
}

.room-member-card--hidden {
    opacity: 0.3;
}

.room-member-name {
    flex-grow: 1;
    font-size: 26px;
    color: var(--lpw-text);
}

.room-member-badge {
    font-size: 20px;
    border-radius: 8px;
    padding: 2px 12px;
    margin-left: 8px;
}

.room-member-badge--owner {
    color: var(--lpw-premium);
    background-color: var(--lpw-warning-subtle);
}

.room-member-badge--verified {
    color: var(--lpw-accent-text);
    background-color: var(--lpw-accent-subtle);
}

.room-info-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
}

.room-info-label {
    font-size: 24px;
    color: var(--lpw-text-secondary);
}

.room-info-value {
    font-size: 28px;
    color: var(--lpw-accent-text);
    -unity-font-style: bold;
}

/* アバタータブ — サブタブ */
.menu-subtab-bar {
    flex-direction: row;
    padding: 0 0 16px;
    border-bottom-width: 1px;
    border-bottom-color: var(--lpw-border);
    margin-bottom: 16px;
}

.menu-subtab {
    flex-grow: 1;
    height: 64px;
    font-size: 22px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--lpw-text-muted);
    border-width: 0;
    border-radius: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
}

.menu-subtab--active {
    color: var(--lpw-accent-text);
    border-bottom-color: var(--lpw-accent);
}

.menu-subcontent--hidden {
    display: none;
}

/* アバタータブ — カード一覧 */
.menu-avatar-list-wrap {
    flex-grow: 1;
}

.menu-avatar-list {
    flex-grow: 1;
}

.menu-avatar-card {
    flex-direction: row;
    align-items: center;
    background-color: var(--lpw-surface-muted);
    border-radius: 12px;
    padding: 20px 24px;
    margin-bottom: 12px;
}

.menu-avatar-card:active {
    background-color: var(--lpw-surface-active);
}

.menu-avatar-card--locked {
    opacity: 0.4;
}

.menu-avatar-card--rejected {
    opacity: 0.5;
    border-width: 1px;
    border-color: var(--lpw-danger);
}

.menu-avatar-name {
    flex-grow: 1;
    font-size: 26px;
    color: var(--lpw-text);
}

.menu-avatar-lock {
    font-size: 28px;
}

.menu-avatar-moderation-badge {
    font-size: 20px;
    border-radius: 8px;
    padding: 2px 12px;
    margin-left: 8px;
}

.menu-avatar-moderation-badge--pending {
    color: var(--lpw-premium);
    background-color: var(--lpw-warning-subtle);
}

.menu-avatar-moderation-badge--rejected {
    color: var(--lpw-danger-text);
    background-color: var(--lpw-danger-subtle);
}

/* アバター変更確認ダイアログ */
.menu-confirm-backdrop {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: var(--lpw-scrim);
    align-items: center;
    justify-content: center;
}

.overlay-hidden {
    display: none;
}

.menu-confirm-dialog {
    background-color: var(--lpw-surface);
    border-radius: 20px;
    padding: 40px;
    width: 520px;
    border-width: 1px;
    border-color: var(--lpw-border);
}

.menu-confirm-title {
    font-size: 32px;
    color: var(--lpw-text);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.menu-confirm-body {
    font-size: 24px;
    color: var(--lpw-text-secondary);
    -unity-text-align: middle-center;
    margin-bottom: 36px;
}

.menu-confirm-buttons {
    flex-direction: row;
    justify-content: flex-end;
}

.menu-confirm-btn {
    height: 72px;
    min-width: 180px;
    font-size: 24px;
    border-radius: 12px;
    border-width: 0;
    margin-left: 16px;
    padding: 0 28px;
}

.menu-confirm-btn--cancel {
    background-color: var(--lpw-surface-hover);
    color: var(--lpw-text-secondary);
}

.menu-confirm-btn--cancel:active {
    background-color: var(--lpw-surface-active);
}

.menu-confirm-btn--ok {
    background-color: var(--lpw-accent);
    color: var(--lpw-text-on-accent);
    -unity-font-style: bold;
}

.menu-confirm-btn--ok:active {
    background-color: var(--lpw-accent-hover);
}

/* ワールド一覧タブ */
.menu-worlds-list {
    flex-grow: 1;
}

.menu-world-card {
    background-color: var(--lpw-surface-muted);
    border-radius: 12px;
    padding: 20px 24px;
    margin-bottom: 12px;
}

.menu-world-card:active {
    background-color: var(--lpw-surface-active);
}

.menu-world-name {
    font-size: 26px;
    color: var(--lpw-text);
    margin-bottom: 6px;
}

.menu-world-players {
    font-size: 22px;
    color: var(--lpw-text-secondary);
}
