.world-detail-root {
    flex: 1;
    flex-direction: column;
    background-color: var(--lpw-bg-page);
}

/* ── Header ──────────────────────────────────────── */

.detail-header {
    flex-direction: row;
    align-items: center;
    height: 52px;
    background-color: var(--lpw-surface);
    border-bottom-width: 1px;
    border-bottom-color: var(--lpw-border);
    padding: 0 8px;
}

.btn-back {
    width: 44px;
    height: 44px;
    background-color: transparent;
    border-width: 0;
    font-size: 24px;
    color: var(--lpw-text-secondary);
}

.header-title {
    flex: 1;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--lpw-text);
    -unity-text-align: middle-center;
}

.btn-like {
    width: 40px;
    height: 40px;
    background-color: transparent;
    border-width: 0;
    font-size: 20px;
    color: var(--lpw-text-muted);
}

.btn-like--active {
    color: var(--lpw-danger);
}

.btn-more {
    width: 40px;
    height: 40px;
    background-color: transparent;
    border-width: 0;
    font-size: 22px;
    color: var(--lpw-text-secondary);
}

/* ── More menu ───────────────────────────────────── */

.more-menu {
    position: absolute;
    right: 8px;
    top: 52px;
    background-color: var(--lpw-surface);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--lpw-border);
    min-width: 180px;
    z-index: 100;
}

.more-menu__item {
    height: 44px;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    color: var(--lpw-text);
    font-size: 14px;
    -unity-text-align: middle-left;
    padding: 0 16px;
}

.more-menu__item--danger {
    color: var(--lpw-danger-text);
}

/* ── Report reason dropdown ──────────────────────── */

.report-reason {
    margin-bottom: 16px;
}

/* ── Scroll content ──────────────────────────────── */

.detail-scroll {
    flex: 1;
}

/* ── Thumbnail ───────────────────────────────────── */

.detail-thumb {
    width: 100%;
    height: 220px;
    background-color: var(--lpw-surface-sunken);
}

/* ── Info ────────────────────────────────────────── */

.detail-info {
    padding: 16px;
    flex-direction: column;
}

.detail-name {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--lpw-text);
    white-space: normal;
    margin-bottom: 8px;
}

.detail-meta {
    flex-direction: row;
    align-items: center;
}

.detail-likes {
    font-size: 14px;
    color: var(--lpw-danger-text);
    margin-right: 16px;
}

.detail-players {
    font-size: 14px;
    color: var(--lpw-success);
}

/* ── Divider ─────────────────────────────────────── */

.detail-divider {
    height: 1px;
    background-color: var(--lpw-border);
    margin: 4px 16px;
}

/* ── Action area ─────────────────────────────────── */

.action-area {
    padding: 16px;
    flex-direction: column;
}

.btn-action {
    height: 52px;
    border-radius: 26px;
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.btn-join-public {
    background-color: var(--lpw-accent);
    border-width: 0;
    color: var(--lpw-text-on-accent);
}

.btn-action--secondary {
    background-color: var(--lpw-accent-subtle);
    border-width: 0;
    color: var(--lpw-accent-text);
}

.btn-action--outline {
    background-color: transparent;
    border-width: 1px;
    border-color: var(--lpw-border-strong);
    color: var(--lpw-text-secondary);
}

/* ── Loading overlay ─────────────────────────────── */

.detail-loading {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--lpw-scrim);
    align-items: center;
    justify-content: center;
}

.loading-label {
    font-size: 16px;
    color: var(--lpw-text-on-status);
}

/* ── Modal ───────────────────────────────────────── */

.modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--lpw-scrim);
    align-items: center;
    justify-content: center;
}

.modal-box {
    background-color: var(--lpw-surface);
    border-radius: 16px;
    padding: 24px;
    width: 300px;
}

.modal-title {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--lpw-text);
    margin-bottom: 12px;
    -unity-text-align: upper-center;
}

.modal-body {
    font-size: 14px;
    color: var(--lpw-text-secondary);
    white-space: normal;
    margin-bottom: 20px;
    -unity-text-align: upper-center;
}

.modal-buttons {
    flex-direction: row;
    justify-content: flex-end;
}

.modal-btn {
    height: 40px;
    border-radius: 8px;
    font-size: 14px;
    padding: 0 16px;
    margin-left: 8px;
}

.modal-btn--cancel {
    background-color: var(--lpw-surface-sunken);
    border-width: 0;
    color: var(--lpw-text-secondary);
}

.modal-btn--ok {
    background-color: var(--lpw-accent);
    border-width: 0;
    color: var(--lpw-text-on-accent);
}
