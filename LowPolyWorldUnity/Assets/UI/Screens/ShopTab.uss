.shop-tab-root {
    flex: 1;
    flex-direction: column;
    background-color: var(--lpw-bg-page);
}

/* ── Fixed header ────────────────────────────────── */

.shop-header {
    flex-direction: column;
    background-color: var(--lpw-surface);
    border-bottom-width: 1px;
    border-bottom-color: var(--lpw-border);
}

.category-tab-bar {
    flex-direction: row;
    height: 42px;
}

.category-tab {
    flex: 1;
    height: 42px;
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    color: var(--lpw-text-muted);
    font-size: 11px;
    padding: 0 2px;
    white-space: nowrap;
}

.category-tab--active {
    color: var(--lpw-text);
    border-bottom-color: var(--lpw-accent);
}

/* ── Coin balance ─────────────────────────────────── */

.coin-area {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding: 4px 12px 6px;
}

.coin-icon {
    font-size: 14px;
    margin-right: 4px;
}

.coin-balance {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--lpw-premium);
}

.coin-balance--negative {
    color: var(--lpw-danger-text);
}

/* ── Search / filter / sort bar ──────────────────── */

.search-filter-bar {
    padding: 8px 12px 6px;
    background-color: var(--lpw-surface);
    border-bottom-width: 1px;
    border-bottom-color: var(--lpw-border);
}

.search-input {
    height: 36px;
    border-radius: 18px;
    background-color: var(--lpw-surface-sunken);
    border-color: var(--lpw-border);
    color: var(--lpw-text);
    font-size: 13px;
    margin-bottom: 6px;
}

.filter-sort-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.sort-btn {
    height: 28px;
    border-radius: 14px;
    background-color: var(--lpw-surface-sunken);
    border-width: 1px;
    border-color: var(--lpw-border);
    color: var(--lpw-text-muted);
    font-size: 12px;
    padding: 0 10px;
    margin-right: 6px;
    margin-bottom: 4px;
}

.sort-btn--active {
    background-color: var(--lpw-accent);
    border-color: var(--lpw-accent);
    color: var(--lpw-text-on-accent);
}

.object-filter-row {
    flex-direction: column;
    margin-top: 2px;
}

.object-subfilter-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 2px;
}

.filter-btn {
    height: 26px;
    border-radius: 13px;
    background-color: var(--lpw-surface-sunken);
    border-width: 1px;
    border-color: var(--lpw-border);
    color: var(--lpw-text-muted);
    font-size: 11px;
    padding: 0 10px;
    margin-right: 6px;
}

.filter-btn--active {
    background-color: var(--lpw-accent);
    border-color: var(--lpw-accent);
    color: var(--lpw-text-on-accent);
}

/* ── Scrollable content ──────────────────────────── */

.tab-scroll {
    flex: 1;
}

/* ── Product list ────────────────────────────────── */

.product-list {
    flex-direction: column;
    padding: 8px;
}

/* ── Product card ────────────────────────────────── */

.product-card {
    flex-direction: row;
    background-color: var(--lpw-surface);
    border-radius: 12px;
    margin-bottom: 10px;
    height: 90px;
    overflow: hidden;
}

.product-card__thumb {
    width: 90px;
    height: 90px;
    background-color: var(--lpw-surface-sunken);
}

.product-card__info {
    flex: 1;
    padding: 10px 12px;
    flex-direction: column;
    justify-content: space-between;
}

.product-card__name-row {
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.product-card__name {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--lpw-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 1;
}

.product-card__edit-badge {
    font-size: 10px;
    border-radius: 8px;
    padding: 1px 6px;
    margin-left: 6px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.product-card__edit-badge--ok {
    background-color: var(--lpw-success-subtle);
    border-width: 1px;
    border-color: var(--lpw-success);
    color: var(--lpw-success);
}

.product-card__edit-badge--ng {
    background-color: var(--lpw-surface-sunken);
    border-width: 1px;
    border-color: var(--lpw-border);
    color: var(--lpw-text-muted);
}

.product-card__creator {
    font-size: 11px;
    color: var(--lpw-text-muted);
}

.product-card__meta {
    flex-direction: row;
    align-items: center;
}

.product-card__price {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--lpw-premium);
    margin-right: 12px;
}

.product-card__likes {
    font-size: 12px;
    color: var(--lpw-danger-text);
    margin-right: 6px;
}

.product-card__like-btn {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background-color: transparent;
    border-width: 0;
    color: var(--lpw-text-muted);
    font-size: 16px;
    padding: 0;
}

.product-card__like-btn--active {
    color: var(--lpw-danger);
}

.product-card__purchase-row {
    padding: 6px 0 0;
}

.product-card__purchase-btn {
    height: 32px;
    border-radius: 16px;
    background-color: var(--lpw-accent);
    border-width: 0;
    color: var(--lpw-text-on-accent);
    font-size: 13px;
    -unity-font-style: bold;
    width: 100%;
}

.product-card__purchase-btn--purchased {
    background-color: var(--lpw-surface-sunken);
    color: var(--lpw-text-muted);
}

.product-card__purchase-btn--balance-negative {
    background-color: var(--lpw-danger-subtle);
    color: var(--lpw-danger-text);
}

/* ── Error toast ──────────────────────────────── */

.error-toast {
    position: absolute;
    top: 56px;
    left: 16px;
    right: 16px;
    background-color: var(--lpw-flash-error-bg);
    border-radius: 10px;
    padding: 12px 16px;
    align-items: center;
}

.error-toast-label {
    font-size: 13px;
    color: var(--lpw-text-on-status);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ── Premium content ─────────────────────────────── */

.premium-features {
    padding: 16px 12px 8px;
}

.premium-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--lpw-text);
    margin-bottom: 12px;
}

.premium-feature-item {
    flex-direction: row;
    align-items: center;
    padding: 10px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--lpw-border);
}

.premium-feature-icon {
    font-size: 24px;
    width: 36px;
    -unity-text-align: middle-center;
    margin-right: 12px;
}

.premium-feature-text {
    flex: 1;
    flex-direction: column;
}

.premium-feature-name {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--lpw-text);
}

.premium-feature-desc {
    font-size: 11px;
    color: var(--lpw-text-muted);
    margin-top: 2px;
}

/* ── Plan purchase ───────────────────────────────── */

.plan-purchase-area {
    padding: 12px;
    flex-direction: column;
}

.plan-card {
    background-color: var(--lpw-surface);
    border-radius: 14px;
    padding: 16px;
    margin-bottom: 10px;
    border-width: 1px;
    border-color: var(--lpw-border);
    flex-direction: column;
}

.plan-card--recommended {
    border-color: var(--lpw-accent);
    background-color: var(--lpw-accent-subtle);
}

.plan-badge-row {
    flex-direction: row;
    margin-bottom: 6px;
}

.plan-badge {
    font-size: 11px;
    color: var(--lpw-text-on-accent);
    background-color: var(--lpw-accent);
    border-radius: 10px;
    padding: 2px 8px;
}

.plan-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--lpw-text);
    margin-bottom: 4px;
}

.plan-price {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--lpw-text);
    margin-bottom: 2px;
}

.plan-monthly {
    font-size: 12px;
    color: var(--lpw-success);
    margin-bottom: 12px;
}

.plan-buy-btn {
    height: 44px;
    border-radius: 22px;
    background-color: var(--lpw-accent);
    border-width: 0;
    color: var(--lpw-text-on-accent);
    font-size: 15px;
    -unity-font-style: bold;
}

.plan-buy-btn--secondary {
    background-color: var(--lpw-surface-sunken);
}

.current-plan-area {
    background-color: var(--lpw-surface);
    border-radius: 12px;
    padding: 14px;
    border-width: 1px;
    border-color: var(--lpw-success);
    flex-direction: column;
}

.current-plan-label {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--lpw-success);
    margin-bottom: 4px;
}

.next-renewal-label {
    font-size: 12px;
    color: var(--lpw-text-muted);
}

/* ── Load more / empty ───────────────────────────── */

.load-more-area {
    align-items: center;
    padding: 16px;
}

.load-more-label {
    font-size: 13px;
    color: var(--lpw-text-muted);
}

.empty-area {
    flex: 1;
    align-items: center;
    justify-content: center;
}

.empty-label {
    font-size: 15px;
    color: var(--lpw-text-muted);
}

/* ── Coin detail panel (bottom sheet) ────────────── */

.coin-detail-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--lpw-scrim);
    justify-content: flex-end;
}

.coin-detail-panel {
    background-color: var(--lpw-surface);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    padding: 0 0 16px;
    max-height: 70%;
    flex-direction: column;
}

.coin-detail-header {
    flex-direction: row;
    align-items: center;
    padding: 16px 16px 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--lpw-border);
}

.coin-detail-title {
    flex: 1;
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--lpw-text);
}

.coin-detail-close-btn {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background-color: var(--lpw-surface-sunken);
    border-width: 0;
    color: var(--lpw-text-secondary);
    font-size: 18px;
    padding: 0;
}

.coin-detail-balance-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 20px 16px 8px;
}

.coin-detail-icon {
    font-size: 32px;
    margin-right: 8px;
}

.coin-detail-balance {
    font-size: 38px;
    -unity-font-style: bold;
    color: var(--lpw-premium);
}

.coin-detail-balance--negative {
    color: var(--lpw-danger-text);
}

.coin-detail-warning {
    background-color: var(--lpw-danger-subtle);
    border-radius: 8px;
    margin: 0 16px 8px;
    padding: 10px 12px;
    border-width: 1px;
    border-color: var(--lpw-danger);
}

.coin-detail-warning-text {
    font-size: 12px;
    color: var(--lpw-danger-text);
    white-space: normal;
}

.coin-detail-section-title {
    font-size: 13px;
    color: var(--lpw-text-muted);
    padding: 8px 16px 4px;
}

.coin-lot-scroll {
    flex: 1;
    min-height: 80px;
}

.coin-lot-list {
    flex-direction: column;
    padding: 0 16px;
}

.coin-lot-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--lpw-border);
}

.coin-lot-expiry {
    flex: 1;
    font-size: 13px;
    color: var(--lpw-text-secondary);
}

.coin-lot-expiry--soon {
    color: var(--lpw-warning);
}

.coin-lot-amount {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--lpw-premium);
}

.coin-lot-empty {
    align-items: center;
    padding: 20px;
}

.coin-lot-empty-label {
    font-size: 13px;
    color: var(--lpw-text-muted);
}

.coin-buy-btn {
    height: 48px;
    border-radius: 24px;
    background-color: var(--lpw-accent);
    border-width: 0;
    color: var(--lpw-text-on-accent);
    font-size: 16px;
    -unity-font-style: bold;
    margin: 12px 16px 4px;
}

/* ── Coin purchase panel (bottom sheet) ──────────── */

.coin-purchase-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--lpw-scrim);
    justify-content: flex-end;
}

.coin-purchase-panel {
    background-color: var(--lpw-surface);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    padding: 0 0 16px;
    max-height: 80%;
    flex-direction: column;
}

.coin-purchase-header {
    flex-direction: row;
    align-items: center;
    padding: 16px 16px 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--lpw-border);
}

.coin-purchase-title {
    flex: 1;
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--lpw-text);
}

.coin-pack-scroll {
    flex: 1;
}

.coin-pack-list {
    flex-direction: column;
    padding: 0 16px;
}

.coin-pack-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--lpw-border);
}

.coin-pack-label {
    flex: 1;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--lpw-premium);
}

.coin-pack-price {
    font-size: 13px;
    color: var(--lpw-text-secondary);
    margin-right: 12px;
}

.coin-pack-buy-btn {
    width: 64px;
    height: 32px;
    border-radius: 16px;
    background-color: var(--lpw-accent);
    border-width: 0;
    color: var(--lpw-text-on-accent);
    font-size: 13px;
    -unity-font-style: bold;
    padding: 0;
}

.coin-pack-buy-btn:disabled {
    background-color: var(--lpw-surface-sunken);
    color: var(--lpw-text-muted);
}
