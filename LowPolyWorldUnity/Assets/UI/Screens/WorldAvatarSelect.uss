.screen-root {
    flex-grow: 1;
    background-color: var(--lpw-bg-page);
}

.screen-header {
    flex-direction: row;
    align-items: center;
    padding: 20px 16px 12px 16px;
    background-color: var(--lpw-surface);
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.btn-cancel {
    width: 110px;
    height: 60px;
    background-color: transparent;
    color: var(--lpw-accent-text);
    font-size: 24px;
    border-width: 0;
    -unity-text-align: middle-left;
}

.screen-title {
    flex-grow: 1;
    color: var(--lpw-text);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.btn-confirm {
    width: 110px;
    height: 56px;
    font-size: 24px;
    border-radius: 12px;
    border-width: 0;
    background-color: var(--lpw-accent);
    color: var(--lpw-text-on-accent);
    -unity-font-style: bold;
}

.btn-confirm.btn--disabled {
    background-color: var(--lpw-surface-sunken);
    color: var(--lpw-text-muted);
}

.tab-bar {
    flex-direction: row;
    background-color: var(--lpw-surface);
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.tab-btn {
    flex-grow: 1;
    height: 68px;
    font-size: 24px;
    background-color: transparent;
    color: var(--lpw-text-muted);
    border-width: 0;
    border-bottom-width: 3px;
    border-color: transparent;
}

.tab-btn.tab--active {
    color: var(--lpw-accent-text);
    border-color: var(--lpw-accent);
}

.loading-overlay {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.loading-label {
    color: var(--lpw-text-muted);
    font-size: 26px;
}

.avatar-list {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    padding: 16px;
}

.avatar-card {
    width: 46%;
    margin: 2%;
    background-color: var(--lpw-surface);
    border-radius: 16px;
    padding: 16px;
    align-items: center;
    border-width: 2px;
    border-color: transparent;
}

.avatar-card--selected {
    border-color: var(--lpw-accent);
    background-color: var(--lpw-accent-subtle);
}

.avatar-card__thumb {
    width: 120px;
    height: 120px;
    background-color: var(--lpw-surface-sunken);
    border-radius: 60px;
    margin-bottom: 12px;
}

.avatar-card__name {
    color: var(--lpw-text);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    white-space: normal;
    max-width: 160px;
}

.avatar-card__badge {
    margin-top: 6px;
    font-size: 18px;
    color: var(--lpw-success);
    background-color: var(--lpw-success-subtle);
    border-radius: 8px;
    padding: 2px 10px;
}

.empty-state {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
}

.empty-label {
    color: var(--lpw-text-muted);
    font-size: 26px;
}

.avatar-card--locked {
    opacity: 0.45;
}

.avatar-card--rejected {
    opacity: 0.5;
    border-color: var(--lpw-danger);
}

.avatar-card__lock-badge {
    margin-top: 6px;
    font-size: 18px;
    color: var(--lpw-text-muted);
    background-color: var(--lpw-surface-sunken);
    border-radius: 8px;
    padding: 2px 10px;
}

.avatar-card__moderation-badge {
    margin-top: 6px;
    font-size: 18px;
    border-radius: 8px;
    padding: 2px 10px;
}

.avatar-card__moderation-badge--pending {
    color: var(--lpw-premium);
    background-color: var(--lpw-warning-subtle);
}

.avatar-card__moderation-badge--rejected {
    color: var(--lpw-danger-text);
    background-color: var(--lpw-danger-subtle);
}
