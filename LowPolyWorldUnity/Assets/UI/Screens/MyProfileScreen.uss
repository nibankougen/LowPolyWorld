.overlay-hidden {
    display: none;
}

.myp-root {
    flex-grow: 1;
    background-color: rgb(18, 18, 22);
}

/* ── ヘッダー ── */
.myp-header {
    flex-direction: row;
    align-items: center;
    padding: 20px 16px 12px 16px;
    background-color: rgb(24, 24, 30);
    border-bottom-width: 1px;
    border-color: rgb(44, 44, 54);
}

.myp-back-btn {
    width: 60px;
    height: 60px;
    background-color: transparent;
    color: rgb(100, 170, 255);
    font-size: 36px;
    border-width: 0;
}

.myp-title {
    flex-grow: 1;
    color: white;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ── ヒーローエリア ── */
.myp-hero {
    align-items: center;
    padding: 32px 20px 20px 20px;
    background-color: rgb(24, 24, 30);
    border-bottom-width: 1px;
    border-color: rgb(40, 40, 52);
}

.myp-avatar-icon {
    width: 120px;
    height: 120px;
    border-radius: 60px;
    background-color: rgb(44, 44, 60);
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
}

.myp-avatar-placeholder {
    font-size: 52px;
    color: rgb(130, 130, 160);
}

.myp-name-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 6px;
}

.myp-display-name {
    font-size: 34px;
    color: white;
    -unity-font-style: bold;
}

.myp-verified-badge {
    font-size: 26px;
    color: rgb(80, 180, 255);
    margin-left: 8px;
    margin-top: 4px;
}

.myp-at-name {
    font-size: 24px;
    color: rgb(130, 130, 155);
}

/* ── ソーシャル数値行 ── */
.myp-stats-row {
    flex-direction: row;
    align-items: stretch;
    background-color: rgb(24, 24, 30);
    border-bottom-width: 1px;
    border-color: rgb(40, 40, 52);
}

.myp-stat-btn {
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 80px;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
}

.myp-stat-count {
    font-size: 28px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.myp-stat-label {
    font-size: 20px;
    color: rgb(130, 130, 155);
    -unity-text-align: middle-center;
}

.myp-stat-divider {
    width: 1px;
    background-color: rgb(44, 44, 58);
    margin-top: 16px;
    margin-bottom: 16px;
}

/* ── スクロールエリア ── */
.myp-scroll {
    flex-grow: 1;
    padding: 24px 20px 40px 20px;
}

.myp-section-title {
    font-size: 22px;
    color: rgba(255, 255, 255, 0.4);
    -unity-font-style: bold;
    margin-top: 20px;
    margin-bottom: 10px;
    padding-left: 4px;
}

.myp-card {
    background-color: rgb(28, 28, 36);
    border-radius: 14px;
    padding: 20px;
    margin-bottom: 4px;
}

.myp-name-field {
    margin-bottom: 8px;
    font-size: 26px;
    height: 60px;
    border-radius: 10px;
    border-color: rgb(60, 60, 80);
    background-color: rgb(38, 38, 50);
    color: white;
    padding: 0 14px;
}

.myp-name-error {
    font-size: 22px;
    color: rgb(240, 80, 80);
    margin-bottom: 8px;
    min-height: 26px;
}

.myp-btn-primary {
    height: 60px;
    font-size: 24px;
    border-radius: 12px;
    border-width: 0;
    background-color: rgb(80, 150, 255);
    color: white;
    -unity-font-style: bold;
}

.myp-btn-primary:disabled {
    background-color: rgb(50, 60, 80);
    color: rgb(120, 120, 140);
}
