.overlay-hidden {
    display: none;
}

.myp-root {
    flex-grow: 1;
    background-color: var(--lpw-bg-page);
}

/* ── ヘッダー ── */
.myp-header {
    flex-direction: row;
    align-items: center;
    padding: 20px 16px 12px 16px;
    background-color: var(--lpw-surface);
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.myp-back-btn {
    width: 60px;
    height: 60px;
    background-color: transparent;
    color: var(--lpw-accent-text);
    font-size: 36px;
    border-width: 0;
}

.myp-title {
    flex-grow: 1;
    color: var(--lpw-text);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ── ヒーローエリア ── */
.myp-hero {
    align-items: center;
    padding: 32px 20px 20px 20px;
    background-color: var(--lpw-surface);
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.myp-avatar-icon {
    width: 120px;
    height: 120px;
    border-radius: 60px;
    background-color: var(--lpw-surface-sunken);
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
}

.myp-avatar-placeholder {
    font-size: 52px;
    color: var(--lpw-text-muted);
}

.myp-name-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 6px;
}

.myp-display-name {
    font-size: 34px;
    color: var(--lpw-text);
    -unity-font-style: bold;
}

.myp-verified-badge {
    font-size: 26px;
    color: var(--lpw-accent-text);
    margin-left: 8px;
    margin-top: 4px;
}

.myp-at-name {
    font-size: 24px;
    color: var(--lpw-text-muted);
}

/* ── ソーシャル数値行 ── */
.myp-stats-row {
    flex-direction: row;
    align-items: stretch;
    background-color: var(--lpw-surface);
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.myp-stat-btn {
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 80px;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
}

.myp-stat-count {
    font-size: 28px;
    color: var(--lpw-text);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.myp-stat-label {
    font-size: 20px;
    color: var(--lpw-text-muted);
    -unity-text-align: middle-center;
}

.myp-stat-divider {
    width: 1px;
    background-color: var(--lpw-border);
    margin-top: 16px;
    margin-bottom: 16px;
}

/* ── スクロールエリア ── */
.myp-scroll {
    flex-grow: 1;
    padding: 24px 20px 40px 20px;
}

.myp-section-title {
    font-size: 22px;
    color: var(--lpw-text-muted);
    -unity-font-style: bold;
    margin-top: 20px;
    margin-bottom: 10px;
    padding-left: 4px;
}

.myp-card {
    background-color: var(--lpw-surface);
    border-radius: 14px;
    padding: 20px;
    margin-bottom: 4px;
}

.myp-name-field {
    margin-bottom: 8px;
    font-size: 26px;
    height: 60px;
    border-radius: 10px;
    border-color: var(--lpw-border);
    background-color: var(--lpw-surface-sunken);
    color: var(--lpw-text);
    padding: 0 14px;
}

.myp-name-error {
    font-size: 22px;
    color: var(--lpw-danger-text);
    margin-bottom: 8px;
    min-height: 26px;
}

.myp-btn-primary {
    height: 60px;
    font-size: 24px;
    border-radius: 12px;
    border-width: 0;
    background-color: var(--lpw-accent);
    color: var(--lpw-text-on-accent);
    -unity-font-style: bold;
}

.myp-btn-primary:disabled {
    background-color: var(--lpw-surface-sunken);
    color: var(--lpw-text-muted);
}
