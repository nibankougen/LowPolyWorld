.overlay-hidden {
    display: none;
}

.screen-root {
    flex-grow: 1;
    background-color: var(--lpw-bg-page);
}

.screen-header {
    flex-direction: row;
    align-items: center;
    padding: 20px 16px 12px 16px;
    background-color: var(--lpw-surface);
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.btn-back {
    width: 60px;
    height: 60px;
    background-color: transparent;
    color: var(--lpw-accent-text);
    font-size: 36px;
    border-width: 0;
}

.screen-title {
    flex-grow: 1;
    color: var(--lpw-text);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.loading-state {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.loading-label {
    color: var(--lpw-text-muted);
    font-size: 26px;
}

.room-list {
    flex-grow: 1;
}

.room-card {
    padding: 16px 20px;
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.room-card__world-name {
    color: var(--lpw-text-secondary);
    font-size: 22px;
    margin-bottom: 4px;
}

.room-card__room-type {
    color: var(--lpw-accent-text);
    font-size: 20px;
    margin-bottom: 8px;
}

.room-card__bottom {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.room-card__players {
    color: var(--lpw-success);
    font-size: 24px;
    -unity-font-style: bold;
}

.room-card__join-btn {
    height: 56px;
    min-width: 120px;
    background-color: var(--lpw-accent);
    color: var(--lpw-text-on-accent);
    font-size: 24px;
    border-radius: 10px;
    border-width: 0;
    padding: 0 20px;
}

.room-card__join-btn--full {
    background-color: var(--lpw-surface-sunken);
    color: var(--lpw-text-muted);
}

.empty-state {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
}

.empty-label {
    color: var(--lpw-text-muted);
    font-size: 26px;
    white-space: normal;
    -unity-text-align: upper-center;
}
