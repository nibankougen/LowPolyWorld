.invite-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--lpw-scrim);
    align-items: center;
    justify-content: center;
}

.invite-panel {
    background-color: var(--lpw-surface);
    border-radius: 20px;
    padding: 32px 24px;
    width: 340px;
    border-width: 1px;
    border-color: var(--lpw-accent-border);
}

.invite-title {
    color: var(--lpw-text);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: 12px;
}

.invite-room-info {
    color: var(--lpw-accent-text);
    font-size: 22px;
    -unity-text-align: upper-center;
    margin-bottom: 20px;
    white-space: normal;
}

.invite-link-area {
    background-color: var(--lpw-surface-sunken);
    border-radius: 10px;
    padding: 12px 14px;
    margin-bottom: 12px;
    border-width: 1px;
    border-color: var(--lpw-border);
}

.invite-link-text {
    color: var(--lpw-accent-text);
    font-size: 18px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.btn-copy {
    height: 60px;
    background-color: var(--lpw-accent);
    color: var(--lpw-text-on-accent);
    font-size: 26px;
    border-radius: 12px;
    border-width: 0;
    margin-bottom: 16px;
}

.invite-meta {
    color: var(--lpw-text-muted);
    font-size: 22px;
    margin-bottom: 6px;
}

.btn-renew {
    height: 52px;
    background-color: var(--lpw-surface-sunken);
    color: var(--lpw-accent-text);
    font-size: 22px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--lpw-accent-border);
    margin-top: 8px;
    margin-bottom: 16px;
}

.invite-divider {
    height: 1px;
    background-color: var(--lpw-border);
    margin-bottom: 16px;
}

.btn-enter {
    height: 60px;
    background-color: var(--lpw-success);
    color: var(--lpw-text-on-status);
    font-size: 26px;
    border-radius: 12px;
    border-width: 0;
    margin-bottom: 10px;
}

.btn-close {
    height: 52px;
    background-color: transparent;
    color: var(--lpw-text-muted);
    font-size: 24px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--lpw-border-strong);
}
