.overlay-hidden {
    display: none;
}

/* ── ルート ── */
.editor-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    flex-direction: column;
}

/* ── ヘッダー ── */
.editor-header {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    background-color: var(--lpw-editor-bar);
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.editor-btn-icon {
    width: 52px;
    height: 52px;
    background-color: transparent;
    border-width: 0;
    color: var(--lpw-accent-text);
    font-size: 32px;
}

/* アイコン共通（白シルエット PNG を背景に表示・枠で囲わない）
   明色背景でも見えるよう暗色ティントを掛ける。 */
.icon-back,
.icon-plus,
.icon-minus,
.icon-next,
.icon-play,
.icon-up,
.icon-down,
.icon-right {
    -unity-background-scale-mode: scale-to-fit;
    background-position-x: center;
    background-position-y: center;
    -unity-background-image-tint-color: var(--lpw-icon);
}

.icon-up {
    background-image: url("../../Textures/UI/Icons/icon_up.png");
    background-size: 70% 70%;
}

.icon-down {
    background-image: url("../../Textures/UI/Icons/icon_down.png");
    background-size: 70% 70%;
}

.icon-right {
    background-image: url("../../Textures/UI/Icons/icon_right.png");
    background-size: 70% 70%;
}

.icon-back {
    background-image: url("../../Textures/UI/Icons/icon_back.png");
    background-size: 55% 55%;
}

.icon-plus {
    background-image: url("../../Textures/UI/Icons/icon_plus.png");
    background-size: 42% 42%;
}

.icon-minus {
    background-image: url("../../Textures/UI/Icons/icon_minus.png");
    background-size: 42% 42%;
}

.icon-next {
    background-image: url("../../Textures/UI/Icons/icon_next.png");
    background-size: 80% 80%;
}

.icon-play {
    background-image: url("../../Textures/UI/Icons/icon_play.png");
    background-size: 92% 92%;
}

/* ワールド名は表示専用（編集は設定タブ） */
.editor-world-name {
    flex-grow: 1;
    height: 44px;
    color: var(--lpw-text);
    font-size: 22px;
    -unity-text-align: middle-left;
    margin: 0 8px;
}

.editor-world-name--empty {
    color: var(--lpw-text-muted);
}

/* チェックボックス（トグル）のチェック枠を角丸にする */
.unity-toggle__checkmark {
    border-radius: 5px;
}

.editor-btn-secondary {
    height: 44px;
    padding: 0 16px;
    background-color: transparent;
    border-width: 1px;
    border-color: var(--lpw-accent);
    border-radius: 8px;
    color: var(--lpw-accent-text);
    font-size: 20px;
    margin-left: 6px;
}

.editor-btn-primary {
    height: 44px;
    padding: 0 16px;
    background-color: var(--lpw-accent);
    border-width: 0;
    border-radius: 8px;
    color: var(--lpw-text-on-accent);
    font-size: 20px;
    margin-left: 6px;
}

/* ── ギズモバー ── */
.gizmo-bar {
    flex-direction: row;
    justify-content: center;
    padding: 6px;
    background-color: var(--lpw-editor-bar);
}

.gizmo-btn {
    width: 100px;
    height: 40px;
    background-color: var(--lpw-surface-sunken);
    border-width: 1px;
    border-color: var(--lpw-border);
    border-radius: 6px;
    color: var(--lpw-text-secondary);
    font-size: 18px;
    margin: 0 4px;
}

.gizmo-btn--active {
    background-color: var(--lpw-accent);
    border-color: var(--lpw-accent);
    color: var(--lpw-text-on-accent);
}

/* ── 3D ビュー領域 ── */
.view3d-area {
    flex-grow: 1;
    position: relative;
}

/* コスト表示は 3D ビューポート上に浮く HUD。他メニューに合わせて半透明白ベースに統一。 */
.cost-display {
    position: absolute;
    top: 10px;
    right: 10px;
    align-items: flex-end;
    background-color: var(--lpw-editor-bar);
    border-radius: 8px;
    padding: 6px 10px;
}

.cost-bar-track {
    width: 120px;
    height: 6px;
    background-color: var(--lpw-surface-sunken);
    border-radius: 3px;
    margin-bottom: 4px;
    overflow: hidden;
}

.cost-bar-fill {
    height: 6px;
    width: 0%;
    background-color: var(--lpw-accent);
    border-radius: 3px;
    transition-duration: 0.2s;
    transition-property: width;
}

.cost-label {
    color: var(--lpw-text);
    font-size: 18px;
}

/* ── 下部タブバー ── */
.bottom-tab-bar {
    flex-direction: row;
    background-color: var(--lpw-editor-bar);
    border-top-width: 1px;
    border-color: var(--lpw-border);
}

.bottom-tab {
    flex-grow: 1;
    height: 56px;
    background-color: transparent;
    border-width: 0;
    color: var(--lpw-text-muted);
    font-size: 20px;
}

.bottom-tab--active {
    color: var(--lpw-accent-text);
    border-top-width: 2px;
    border-color: var(--lpw-accent);
}

.bottom-tab-minimize {
    width: 52px;
    height: 56px;
    background-color: transparent;
    border-width: 0;
    /* ボタンが正方形でないため px 指定でアスペクト比 1:1 を保つ */
    background-size: 15px 15px;
}

/* ── タブコンテンツ ── */
.tab-content {
    background-color: var(--lpw-editor-panel);
    height: 55%;
    overflow: hidden;
    transition: height 0.22s ease-in-out;
}

/* ギミック / 設定タブ: ヘッダー直下まで大きく開いた状態を既定にする */
.tab-content--tall {
    height: 92%;
}

/* メニュー最小化（▽）: 高さを 0 にしてアニメーションで閉じる */
.tab-content--min {
    height: 0;
}

.tab-panel {
    flex-grow: 1;
    flex-direction: column;
}

.stub-label {
    color: var(--lpw-text-muted);
    font-size: 20px;
    -unity-text-align: middle-center;
    padding: 30px;
}

/* ── 設定タブ ── */
.settings-scroll {
    flex-grow: 1;
}

.settings-section {
    padding: 14px 16px;
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.settings-label {
    color: var(--lpw-text);
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.settings-hint {
    color: var(--lpw-text-muted);
    font-size: 16px;
    margin-top: 4px;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.settings-row-label {
    width: 90px;
    color: var(--lpw-text-secondary);
    font-size: 18px;
}

.settings-row-value {
    width: 55px;
    color: var(--lpw-text-secondary);
    font-size: 18px;
    -unity-text-align: middle-right;
}

.settings-input {
    height: 44px;
    background-color: var(--lpw-surface-sunken);
    border-color: var(--lpw-border);
    border-radius: 8px;
    color: var(--lpw-text);
    font-size: 20px;
}

.settings-slider {
    flex-grow: 1;
    margin: 0 8px;
}

.settings-toggle {
    margin-left: auto;
}

.color-input {
    width: 120px;
    height: 36px;
    border-radius: 6px;
    font-size: 18px;
}

/* ── 共通: 文字入力・ドロップダウンの角丸スタイル（ワールド編集画面で統一） ── */
/* ルート要素は装飾を持たせず、実際の入力ボックス（子要素）を角丸に統一する。 */
.unity-base-text-field,
.unity-base-popup-field {
    background-color: transparent;
    border-width: 0;
}

.unity-base-text-field__input,
.unity-base-popup-field__input {
    background-color: var(--lpw-surface);
    border-width: 1px;
    border-color: var(--lpw-border-strong);
    border-radius: 8px;
    color: var(--lpw-text);
    padding: 4px 10px;
}

.unity-base-popup-field__input {
    -unity-text-align: middle-left;
}

/* ドロップダウンを開いたときのポップアップメニューも角丸・統一する */
.unity-base-dropdown__container-outer {
    background-color: var(--lpw-surface);
    border-width: 1px;
    border-color: var(--lpw-border-strong);
    border-radius: 8px;
    overflow: hidden;
}

.unity-base-dropdown__container-inner {
    border-radius: 8px;
}

.unity-base-dropdown__item {
    padding: 6px 10px;
}

.unity-base-dropdown__item:hover {
    background-color: var(--lpw-accent-subtle);
}

.unity-base-dropdown__label {
    color: var(--lpw-text);
    font-size: 15px;
}

.unity-base-dropdown__checkmark {
    --unity-image-tint-color: var(--lpw-text);
}

/* ── テストプレイ ── */
.btn-test-play {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 52px;
    background-color: var(--lpw-success);
    border-width: 0;
    border-radius: 10px;
}

.btn-play-icon {
    width: 24px;
    height: 24px;
    margin-right: 8px;
    /* 緑のテストプレイボタン上は白アイコン */
    -unity-background-image-tint-color: var(--lpw-text-on-status);
}

.btn-play-label {
    color: var(--lpw-text-on-status);
    font-size: 22px;
}

/* ── サムネイル ── */
.thumbnail-preview {
    width: 120px;
    height: 213px;
    background-color: var(--lpw-surface-sunken);
    border-radius: 8px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: var(--lpw-border);
}

.thumbnail-hint {
    color: var(--lpw-text-muted);
    font-size: 16px;
    -unity-text-align: middle-center;
}

/* ── タグ ── */
.tag-chips-container {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.settings-tag-chip {
    flex-direction: row;
    align-items: center;
    height: 34px;
    padding: 0 10px;
    margin: 3px;
    background-color: var(--lpw-accent);
    border-radius: 17px;
    border-width: 0;
}

.settings-tag-chip__label {
    color: var(--lpw-text-on-accent);
    font-size: 18px;
    margin-right: 6px;
}

.settings-tag-chip__remove {
    color: var(--lpw-text-on-accent);
    font-size: 16px;
    background-color: transparent;
    border-width: 0;
    width: 22px;
    height: 22px;
    padding: 0;
}

.tag-input-row {
    flex-direction: row;
    align-items: center;
}

.tag-input {
    flex-grow: 1;
    height: 42px;
    font-size: 18px;
}

.btn-tag-add {
    height: 42px;
    padding: 0 14px;
    margin-left: 8px;
    background-color: var(--lpw-accent);
    border-width: 0;
    border-radius: 8px;
    color: var(--lpw-text-on-accent);
    font-size: 18px;
}

.tag-error {
    color: var(--lpw-danger-text);
    font-size: 16px;
    margin-top: 4px;
}

/* ── BGM ── */
/* BGM 選択ボタン（タップで選択リストオーバーレイを開く） */
.bgm-select-btn {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    background-color: var(--lpw-accent-subtle);
    border-width: 0;
    border-radius: 8px;
    margin-bottom: 4px;
}

.bgm-current {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    background-color: transparent;
}

.bgm-current-name {
    flex-grow: 1;
    color: var(--lpw-text);
    font-size: 20px;
    -unity-text-align: middle-left;
}

.bgm-current-author {
    color: var(--lpw-accent-text);
    font-size: 16px;
}

.bgm-select-chevron {
    width: 22px;
    height: 22px;
    margin-left: 8px;
}

/* BGM 選択リスト（ピッカー）の項目内テキスト */
.bgm-picker-name {
    color: var(--lpw-text);
    font-size: 16px;
    -unity-text-align: middle-left;
}

.gimmick-picker-item--selected .bgm-picker-name {
    color: var(--lpw-text-on-accent);
}

.bgm-picker-author {
    color: var(--lpw-text-muted);
    font-size: 12px;
    -unity-text-align: middle-left;
}

/* ── ステッパー（人数上限） ── */
.stepper-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.stepper-btn {
    width: 52px;
    height: 52px;
    background-color: var(--lpw-surface-sunken);
    border-width: 1px;
    border-color: var(--lpw-border);
    border-radius: 8px;
    color: var(--lpw-accent-text);
    font-size: 26px;
}

.stepper-value {
    flex-grow: 1;
    color: var(--lpw-text);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ── ラジオボタン行 ── */
.radio-row {
    flex-direction: row;
    margin-top: 6px;
}

.radio-btn {
    flex-grow: 1;
    height: 44px;
    background-color: var(--lpw-surface-sunken);
    border-width: 1px;
    border-color: var(--lpw-border);
    border-radius: 0;
    color: var(--lpw-text-secondary);
    font-size: 18px;
}

/* UI Toolkit は :first-child / :last-child 擬似クラスを未サポートのため、
   UXML 側で先頭・末尾ボタンに明示クラスを付与して角丸を当てる */
.radio-btn--first {
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
}

.radio-btn--last {
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

.radio-btn--active {
    background-color: var(--lpw-accent);
    border-color: var(--lpw-accent);
    color: var(--lpw-text-on-accent);
}

/* ── バージョン ── */
.version-label {
    color: var(--lpw-text-muted);
    font-size: 18px;
    -unity-text-align: middle-center;
}

/* ── 公開ボタン ── */
.btn-publish-full {
    height: 56px;
    background-color: var(--lpw-accent);
    border-width: 0;
    border-radius: 10px;
    color: var(--lpw-text-on-accent);
    font-size: 22px;
    margin-bottom: 8px;
}

.publish-errors {
    flex-direction: column;
    padding: 8px;
    background-color: var(--lpw-danger-subtle);
    border-radius: 8px;
}

.publish-error-item {
    color: var(--lpw-danger-text);
    font-size: 18px;
    padding: 2px 0;
}

/* ── 地形タブ（11.7.2） ── */
.terrain-view-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* 上方非表示トグル・高さバーは 3D ビューポート上に浮く HUD。
   他メニューに合わせて半透明白ベースに統一（active のみアクセント）。 */
.terrain-hide-above {
    position: absolute;
    top: 10px;
    left: 10px;
    height: 40px;
    padding: 0 14px;
    background-color: var(--lpw-editor-bar);
    border-width: 1px;
    border-color: var(--lpw-border);
    border-radius: 8px;
    color: var(--lpw-text-secondary);
    font-size: 18px;
}

.terrain-hide-above--active {
    background-color: var(--lpw-accent);
    border-color: var(--lpw-accent);
    color: var(--lpw-text-on-accent);
}

.terrain-height-bar {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 56px;
    align-items: center;
    background-color: var(--lpw-editor-bar);
    border-radius: 10px;
    padding: 6px 0;
}

.terrain-height-btn {
    width: 44px;
    height: 44px;
    background-color: var(--lpw-surface-sunken);
    border-width: 1px;
    border-color: var(--lpw-border);
    border-radius: 8px;
    margin: 2px 0;
    background-size: 20px 20px;
}

.terrain-height-label {
    color: var(--lpw-text);
    font-size: 22px;
    -unity-font-style: bold;
    margin: 4px 0;
}

.terrain-flash {
    position: absolute;
    bottom: 16px;
    align-self: center;
    padding: 8px 18px;
    background-color: var(--lpw-flash-error-bg);
    border-radius: 10px;
    color: var(--lpw-text-on-status);
    font-size: 20px;
}

.terrain-edit-bar {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 6px 8px;
    background-color: var(--lpw-editor-bar);
}

/* 地形タブ最小化中は編集バー（ツール）以外を隠す */
.terrain-minimized .terrain-select-method,
.terrain-minimized .terrain-subtab-bar,
.terrain-minimized .terrain-list-scroll {
    display: none;
}

.terrain-mode-btn {
    width: 46px;
    height: 44px;
    padding: 0;
    background-color: var(--lpw-surface-sunken);
    border-width: 1px;
    border-color: var(--lpw-border);
    border-radius: 6px;
    color: var(--lpw-text-secondary);
    font-size: 24px;
    -unity-text-align: middle-center;
    margin: 2px 3px;
}

.terrain-mode-btn--active {
    background-color: var(--lpw-accent);
    border-color: var(--lpw-accent);
    color: var(--lpw-text-on-accent);
}

/* 編集ツールのアイコン画像（Assets/Textures/UI/Icons・128×128 PNG） */
.terrain-icon {
    -unity-background-scale-mode: scale-to-fit;
    background-size: 64% 64%;
    background-position-x: center;
    background-position-y: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--lpw-icon);
}

/* アクティブな地形ツール（アクセント背景）はアイコンを白に */
.terrain-mode-btn--active .terrain-icon,
.terrain-mode-btn--active.terrain-icon {
    -unity-background-image-tint-color: var(--lpw-text-on-accent);
}

.terrain-icon--brush {
    background-image: url("../../Textures/UI/Icons/icon_tool_brush.png");
}

.terrain-icon--eraser {
    background-image: url("../../Textures/UI/Icons/icon_tool_eraser.png");
}

.terrain-icon--shape {
    background-image: url("../../Textures/UI/Icons/icon_tool_shape.png");
}

.terrain-icon--select {
    background-image: url("../../Textures/UI/Icons/icon_tool_select.png");
}

.terrain-icon--move {
    background-image: url("../../Textures/UI/Icons/icon_tool_move.png");
}

.terrain-icon--type {
    background-image: url("../../Textures/UI/Icons/icon_change_terrain_type.png");
}

.terrain-icon--copy {
    background-image: url("../../Textures/UI/Icons/icon_copy.png");
}

/* コピー等のアクションボタンをアイコン表示にする（正方形・パディング 0） */
.terrain-action-btn--icon {
    width: 46px;
    padding: 0;
}

.terrain-action-btn {
    height: 44px;
    padding: 0 14px;
    background-color: transparent;
    border-width: 1px;
    border-color: var(--lpw-accent);
    border-radius: 6px;
    color: var(--lpw-accent-text);
    font-size: 18px;
    margin: 2px 3px;
}

.terrain-select-method {
    color: var(--lpw-text-secondary);
    font-size: 16px;
    padding: 2px 12px;
}

.terrain-subtab-bar {
    flex-direction: row;
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.terrain-subtab {
    flex-grow: 1;
    height: 42px;
    background-color: transparent;
    border-width: 0;
    color: var(--lpw-text-muted);
    font-size: 18px;
}

.terrain-subtab--active {
    color: var(--lpw-accent-text);
    border-bottom-width: 2px;
    border-color: var(--lpw-accent);
}

.terrain-list-scroll {
    flex-grow: 1;
}

.terrain-list {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 8px;
}

.terrain-item {
    width: 92px;
    align-items: center;
    margin: 4px;
    padding: 6px;
    background-color: var(--lpw-surface-muted);
    border-width: 1px;
    border-color: var(--lpw-border);
    border-radius: 8px;
}

.terrain-item--selected {
    border-color: var(--lpw-accent);
    background-color: var(--lpw-accent-subtle);
}

.terrain-item-thumb {
    width: 64px;
    height: 64px;
    border-radius: 6px;
    background-color: var(--lpw-surface-sunken);
}

.terrain-item-name {
    color: var(--lpw-text-secondary);
    font-size: 14px;
    margin-top: 4px;
    overflow: hidden;
}

.terrain-item-warn {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 22px;
    height: 22px;
    background-color: var(--lpw-warning);
    border-radius: 11px;
    color: var(--lpw-text-on-status);
    font-size: 15px;
    -unity-text-align: middle-center;
    border-width: 0;
    padding: 0;
}

/* ───── オブジェクトタブ ───── */

.object-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 6px 12px;
    background-color: var(--lpw-editor-bar);
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.object-header-label {
    color: var(--lpw-text-secondary);
    font-size: 16px;
}

.object-count-label {
    color: var(--lpw-text-secondary);
    font-size: 18px;
}

.object-selection-bar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 6px 8px;
    background-color: var(--lpw-editor-bar);
}

.object-action-btn {
    height: 38px;
    padding: 0 14px;
    background-color: transparent;
    border-width: 1px;
    border-color: var(--lpw-accent);
    border-radius: 6px;
    color: var(--lpw-accent-text);
    font-size: 16px;
    margin: 2px 4px;
}

.object-scale-group {
    flex-direction: row;
    align-items: center;
    margin: 2px 6px;
}

.object-scale-axis {
    color: var(--lpw-text-secondary);
    font-size: 15px;
    margin-right: 4px;
}

.object-scale-btn {
    width: 30px;
    height: 30px;
    background-color: var(--lpw-surface-sunken);
    border-width: 1px;
    border-color: var(--lpw-border);
    border-radius: 6px;
    color: var(--lpw-text);
    font-size: 18px;
    padding: 0;
}

.object-scale-label {
    width: 44px;
    color: var(--lpw-text-secondary);
    font-size: 15px;
    -unity-text-align: middle-center;
}

.object-subtab-bar {
    flex-direction: row;
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.object-subtab {
    flex-grow: 1;
    height: 42px;
    background-color: transparent;
    border-width: 0;
    color: var(--lpw-text-muted);
    font-size: 18px;
}

.object-subtab--active {
    color: var(--lpw-accent-text);
    border-bottom-width: 2px;
    border-color: var(--lpw-accent);
}

.object-subtab-content {
    flex-grow: 1;
}

.object-list-scroll {
    flex-grow: 1;
}

.object-list {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 8px;
}

.object-item {
    width: 92px;
    align-items: center;
    margin: 4px;
    padding: 6px;
    background-color: var(--lpw-surface-muted);
    border-width: 1px;
    border-color: var(--lpw-border);
    border-radius: 8px;
}

.object-item--selected {
    border-color: var(--lpw-accent);
    background-color: var(--lpw-accent-subtle);
}

.object-item-thumb {
    width: 64px;
    height: 64px;
    border-radius: 6px;
    background-color: var(--lpw-surface-sunken);
}

.object-item-name {
    color: var(--lpw-text-secondary);
    font-size: 14px;
    margin-top: 4px;
    overflow: hidden;
}

.object-item-cost {
    color: var(--lpw-text-muted);
    font-size: 12px;
}

.object-flash {
    position: absolute;
    bottom: 16px;
    align-self: center;
    padding: 8px 18px;
    background-color: var(--lpw-flash-error-bg);
    border-radius: 10px;
    color: var(--lpw-text-on-status);
    font-size: 20px;
}

/* ───── ギミックタブ ───── */

.gimmick-scroll {
    flex-grow: 1;
}

.gimmick-section {
    padding: 6px 10px;
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.gimmick-collapse-header {
    flex-direction: row;
    align-items: center;
    height: 36px;
    background-color: transparent;
    border-width: 0;
    color: var(--lpw-text);
    font-size: 16px;
    -unity-text-align: middle-left;
    padding: 0 2px;
}

.gimmick-collapse-arrow {
    width: 16px;
    height: 16px;
    margin-right: 6px;
}

.gimmick-states-body {
    padding-bottom: 4px;
}

.gimmick-subhead {
    color: var(--lpw-text-muted);
    font-size: 14px;
    margin: 6px 2px 2px 2px;
}

.gimmick-state-list {
    flex-direction: column;
}

.gimmick-state-row {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
}

.gimmick-state-index {
    width: 22px;
    color: var(--lpw-text-muted);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.gimmick-state-name {
    flex-grow: 1;
    margin: 0 4px;
    font-size: 15px;
}

.gimmick-state-value {
    width: 64px;
    font-size: 15px;
}

/* カテゴリ見出し行（見出し + ＋追加ボタン） */
.gimmick-state-cat-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
}

/* ステート行の削除ボタン */
.gimmick-state-del {
    width: 28px;
    height: 28px;
    margin-left: 4px;
    background-color: var(--lpw-surface-sunken);
    border-width: 1px;
    border-color: var(--lpw-border);
    border-radius: 6px;
    padding: 0;
}

.gimmick-state-empty {
    color: var(--lpw-text-muted);
    font-size: 13px;
    padding: 2px 0 2px 24px;
}

.gimmick-rules-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.gimmick-add-btn {
    width: 34px;
    height: 34px;
    background-color: var(--lpw-surface-sunken);
    border-width: 1px;
    border-color: var(--lpw-accent);
    border-radius: 8px;
    color: var(--lpw-accent-text);
    font-size: 20px;
    padding: 0;
}

.gimmick-rule-list {
    flex-direction: column;
    padding: 4px 0;
}

.gimmick-rule-row {
    flex-direction: row;
    align-items: center;
    height: 44px;
    margin: 3px 0;
    padding: 0 6px;
    background-color: var(--lpw-surface-muted);
    border-width: 1px;
    border-color: var(--lpw-border);
    border-radius: 8px;
}

.gimmick-rule-name {
    flex-grow: 1;
    color: var(--lpw-text);
    font-size: 16px;
    -unity-text-align: middle-left;
    background-color: transparent;
    border-width: 0;
    padding: 0 4px;
}

.gimmick-rule-btn {
    width: 32px;
    height: 32px;
    margin-left: 4px;
    background-color: var(--lpw-surface-sunken);
    border-width: 1px;
    border-color: var(--lpw-border);
    border-radius: 6px;
    color: var(--lpw-text-secondary);
    font-size: 16px;
    padding: 0;
}

.gimmick-rule-empty {
    color: var(--lpw-text-muted);
    font-size: 14px;
    -unity-text-align: middle-center;
    padding: 12px;
}

/* アイコンボタン（白シルエット PNG・mipmap 無効・内側に収める） */
.gimmick-icon-btn {
    -unity-background-scale-mode: scale-to-fit;
    background-size: 62% 62%;
    background-position-x: center;
    background-position-y: center;
    -unity-background-image-tint-color: var(--lpw-icon);
}

.gimmick-icon-btn--plus {
    background-image: url("../../Textures/UI/Icons/icon_plus.png");
}

.gimmick-icon-btn--edit {
    background-image: url("../../Textures/UI/Icons/icon_edit.png");
}

.gimmick-icon-btn--up {
    background-image: url("../../Textures/UI/Icons/icon_up.png");
}

.gimmick-icon-btn--down {
    background-image: url("../../Textures/UI/Icons/icon_down.png");
}

.gimmick-icon-btn--close {
    background-image: url("../../Textures/UI/Icons/icon_close.png");
}

/* ── ルール編集画面（オーバーレイ） ── */
.gimmick-rule-editor,
.editor-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--lpw-editor-panel);
    flex-direction: column;
}

.gimmick-edit-header {
    flex-direction: row;
    align-items: center;
    height: 48px;
    padding: 0 8px;
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

/* 戻る / 閉じるは枠で囲わずアイコンのみ（ヘッダー戻ると統一） */
.gimmick-edit-back {
    width: 44px;
    height: 44px;
    background-color: transparent;
    border-width: 0;
    padding: 0;
}

/* ルール名（ヘッダー直下の行） */
.gimmick-edit-titlerow {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.gimmick-edit-titlelabel {
    width: 70px;
    color: var(--lpw-text-muted);
    font-size: 14px;
}

.gimmick-edit-title {
    flex-grow: 1;
}

.gimmick-edit-scroll {
    flex-grow: 1;
}

.gimmick-edit-section {
    padding: 6px 10px;
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.gimmick-edit-section-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.gimmick-edit-list {
    flex-direction: column;
    padding: 4px 0;
}

.gimmick-edit-empty {
    color: var(--lpw-text-muted);
    font-size: 13px;
    -unity-text-align: middle-center;
    padding: 8px;
}

.gimmick-edit-row {
    flex-direction: column;
    margin: 3px 0;
    padding: 6px;
    background-color: var(--lpw-surface-muted);
    border-width: 1px;
    border-color: var(--lpw-border);
    border-radius: 8px;
}

.gimmick-edit-row-main {
    flex-direction: row;
    align-items: center;
}

/* 種類セレクタボタン（タップで選択リストを開く・角丸で入力欄と統一） */
.gimmick-edit-typebtn {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    margin: 0 4px 0 0;
    height: 38px;
    background-color: var(--lpw-surface);
    border-width: 1px;
    border-color: var(--lpw-border-strong);
    border-radius: 8px;
    padding: 0 10px;
}

.gimmick-edit-typebtn-label {
    flex-grow: 1;
    color: var(--lpw-text);
    font-size: 15px;
    -unity-text-align: middle-left;
}

/* surface 背景上のため icon_next を暗色にティントして見えるようにする */
.gimmick-edit-typebtn-next {
    width: 18px;
    height: 18px;
    margin-left: 6px;
    -unity-background-image-tint-color: var(--lpw-text-muted);
}

.gimmick-edit-row-btn {
    width: 32px;
    height: 32px;
    margin-left: 4px;
    background-color: var(--lpw-surface-sunken);
    border-width: 1px;
    border-color: var(--lpw-border);
    border-radius: 8px;
    padding: 0;
}

/* ── 種別ごとの詳細パラメータフォーム ── */
.gimmick-edit-params {
    flex-direction: column;
    margin-top: 6px;
    padding: 6px 4px 2px 4px;
    border-top-width: 1px;
    border-color: var(--lpw-border);
}

.gimmick-edit-param {
    margin: 3px 0;
}

.gimmick-edit-param .unity-base-field__label {
    min-width: 120px;
    color: var(--lpw-text-muted);
    font-size: 13px;
}

.gimmick-edit-param-group {
    flex-direction: column;
    margin: 3px 0;
}

.gimmick-edit-param-xyz {
    flex-direction: row;
}

.gimmick-edit-param-xyz .gimmick-edit-param {
    flex-grow: 1;
    margin-right: 4px;
}

.gimmick-edit-param-xyz .unity-base-field__label {
    min-width: 14px;
}

/* 値参照の入れ子フォーム */
.gimmick-edit-valueref {
    flex-direction: column;
    margin: 4px 0;
    padding: 6px;
    background-color: var(--lpw-surface-sunken);
    border-radius: 6px;
}

.gimmick-edit-message {
    margin-top: 6px;
}

.gimmick-edit-message-field {
    margin-top: 4px;
}

/* 入力欄の高さ（見た目は共通スタイルで角丸・surface 背景に統一） */
.gimmick-edit-title {
    font-size: 16px;
}

.gimmick-edit-message-field {
    font-size: 15px;
}

.gimmick-edit-title .unity-base-text-field__input {
    min-height: 38px;
}

.gimmick-edit-message-field .unity-base-text-field__input {
    min-height: 56px;
}

/* ── 種類選択リスト（ピッカー・カテゴリ見出し付き） ── */
.gimmick-picker-title {
    flex-grow: 1;
    margin-left: 8px;
    color: var(--lpw-text);
    font-size: 16px;
    -unity-text-align: middle-left;
}

.gimmick-picker-category {
    color: var(--lpw-text-muted);
    font-size: 13px;
    -unity-font-style: bold;
    margin: 12px 10px 2px 10px;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.gimmick-picker-item {
    min-height: 42px;
    margin: 2px 10px;
    justify-content: center;
    background-color: var(--lpw-surface-muted);
    border-width: 1px;
    border-color: var(--lpw-border);
    border-radius: 8px;
    color: var(--lpw-text);
    font-size: 15px;
    -unity-text-align: middle-left;
    padding: 4px 12px;
}

.gimmick-picker-item:hover {
    background-color: var(--lpw-surface-sunken);
}

.gimmick-picker-item--selected {
    background-color: var(--lpw-accent);
    border-color: var(--lpw-accent);
    color: var(--lpw-text-on-accent);
}

/* ── テンプレートから追加 ── */
/* メニュー上部の全幅ボタン */
.gimmick-template-top-btn {
    height: 40px;
    margin: 4px 2px 8px 2px;
    background-color: var(--lpw-surface-sunken);
    border-width: 1px;
    border-color: var(--lpw-accent);
    border-radius: 8px;
    color: var(--lpw-accent-text);
    font-size: 15px;
}

/* アイコン + ラベルを横並びにするボタン */
.gimmick-template-top-btn--icon {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.gimmick-btn-icon {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    -unity-background-image-tint-color: var(--lpw-accent-text);
}

.gimmick-btn-label {
    color: var(--lpw-accent-text);
    font-size: 15px;
}

.icon-dialogue {
    -unity-background-scale-mode: scale-to-fit;
    background-position-x: center;
    background-position-y: center;
    background-image: url("../../Textures/UI/Icons/icon_dialogue.png");
    background-size: 90% 90%;
}

/* テンプレート一覧の項目（名前 + 説明の 2 行） */
.gimmick-template-item {
    flex-direction: column;
    min-height: 56px;
    margin: 3px 10px;
    justify-content: center;
    background-color: var(--lpw-surface-muted);
    border-width: 1px;
    border-color: var(--lpw-border);
    border-radius: 8px;
    padding: 8px 12px;
}

.gimmick-template-item:hover {
    background-color: var(--lpw-surface-sunken);
}

.gimmick-template-item-name {
    color: var(--lpw-text);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.gimmick-template-item-desc {
    color: var(--lpw-text-muted);
    font-size: 12px;
    white-space: normal;
    -unity-text-align: upper-left;
    margin-top: 2px;
}

/* パラメータ入力フォーム */
.gimmick-template-params {
    flex-grow: 1;
    padding: 12px;
}

.gimmick-template-param-desc {
    color: var(--lpw-text-muted);
    font-size: 13px;
    white-space: normal;
    margin: 4px 0 12px 0;
}

.gimmick-template-param-fields {
    flex-direction: column;
}

.gimmick-template-param-row {
    flex-direction: row;
    align-items: center;
    margin: 4px 0;
}

.gimmick-template-param-label {
    flex-grow: 1;
    color: var(--lpw-text);
    font-size: 15px;
}

.gimmick-template-param-field {
    width: 100px;
}

.gimmick-template-insert-btn {
    height: 44px;
    margin-top: 16px;
    background-color: var(--lpw-accent);
    border-width: 0;
    border-radius: 8px;
    color: var(--lpw-text-on-accent);
    font-size: 16px;
}

/* ── 会話（ライブラリ / エディタ）── */
/* ライブラリの会話行 */
.conv-row {
    flex-direction: row;
    align-items: center;
    min-height: 44px;
    margin: 3px 10px;
    padding: 0 6px;
    background-color: var(--lpw-surface-muted);
    border-width: 1px;
    border-color: var(--lpw-border);
    border-radius: 8px;
}

.conv-name {
    flex-grow: 1;
    color: var(--lpw-text);
    font-size: 15px;
    -unity-text-align: middle-left;
    background-color: transparent;
    border-width: 0;
    padding: 0 4px;
}

.conv-meta {
    color: var(--lpw-text-muted);
    font-size: 12px;
    margin-right: 6px;
}

.conv-small-btn {
    width: 30px;
    height: 30px;
    margin-left: 4px;
    background-color: var(--lpw-surface-sunken);
    border-width: 1px;
    border-color: var(--lpw-border);
    border-radius: 6px;
    padding: 0;
}

/* エディタのセリフ行カード */
.conv-line-card {
    flex-direction: column;
    margin: 4px 10px;
    padding: 8px;
    background-color: var(--lpw-surface-muted);
    border-width: 1px;
    border-color: var(--lpw-border);
    border-radius: 8px;
}

.conv-line-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.conv-line-index {
    width: 26px;
    color: var(--lpw-text-muted);
    font-size: 13px;
    -unity-text-align: middle-left;
}

.conv-line-speaker {
    flex-grow: 1;
    font-size: 14px;
}

.conv-line-text {
    font-size: 15px;
    white-space: normal;
}

.conv-line-text .unity-text-field__input {
    min-height: 48px;
    white-space: normal;
}

.conv-row-label {
    color: var(--lpw-text-muted);
    font-size: 12px;
    margin: 6px 0 2px 0;
}

.conv-goto {
    margin-top: 2px;
}

.conv-choice-row {
    flex-direction: row;
    align-items: center;
    margin: 2px 0 2px 12px;
}

.conv-choice-text {
    flex-grow: 1;
    font-size: 14px;
}

.conv-add-choice-btn {
    height: 30px;
    margin: 4px 0 0 12px;
    padding: 0 10px;
    align-self: flex-start;
    background-color: var(--lpw-surface-sunken);
    border-width: 1px;
    border-color: var(--lpw-border);
    border-radius: 6px;
    color: var(--lpw-text-secondary);
    font-size: 13px;
}

.conv-empty {
    color: var(--lpw-text-muted);
    font-size: 14px;
    -unity-text-align: middle-center;
    padding: 12px;
}
