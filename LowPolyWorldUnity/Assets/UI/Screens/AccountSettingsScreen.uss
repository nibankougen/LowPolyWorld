.overlay-hidden {
    display: none;
}

.acct-root {
    flex-grow: 1;
    background-color: var(--lpw-bg-page);
}

/* ── ヘッダー ── */
.acct-header {
    flex-direction: row;
    align-items: center;
    padding: 20px 16px 12px 16px;
    background-color: var(--lpw-surface);
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.acct-back-btn {
    width: 60px;
    height: 60px;
    background-color: transparent;
    color: var(--lpw-accent-text);
    font-size: 36px;
    border-width: 0;
}

.acct-title {
    flex-grow: 1;
    color: var(--lpw-text);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ── スクロール ── */
.acct-scroll {
    flex-grow: 1;
    padding: 24px 20px 40px 20px;
}

/* ── セクションタイトル ── */
.acct-section-title {
    font-size: 22px;
    color: var(--lpw-text-muted);
    -unity-font-style: bold;
    margin-top: 28px;
    margin-bottom: 10px;
    padding-left: 4px;
}

/* ── カード ── */
.acct-card {
    background-color: var(--lpw-surface);
    border-radius: 14px;
    padding: 20px;
    margin-bottom: 4px;
}

/* ── @name セクション ── */
.acct-current-name {
    font-size: 28px;
    color: var(--lpw-text);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.acct-next-change {
    font-size: 22px;
    color: var(--lpw-text-muted);
    margin-bottom: 16px;
}

.acct-name-field {
    margin-bottom: 8px;
    font-size: 26px;
    height: 60px;
    border-radius: 10px;
    border-color: var(--lpw-border);
    background-color: var(--lpw-surface-sunken);
    color: var(--lpw-text);
    padding: 0 14px;
}

.acct-name-error {
    font-size: 22px;
    color: var(--lpw-danger-text);
    margin-bottom: 8px;
    min-height: 26px;
}

.acct-name-caution {
    font-size: 20px;
    color: var(--lpw-text-muted);
    white-space: normal;
    margin-bottom: 18px;
    -unity-text-align: upper-left;
}

.acct-btn-primary {
    height: 60px;
    font-size: 24px;
    border-radius: 12px;
    border-width: 0;
    background-color: var(--lpw-accent);
    color: var(--lpw-text-on-accent);
    -unity-font-style: bold;
}

.acct-btn-primary:disabled {
    background-color: var(--lpw-surface-sunken);
    color: var(--lpw-text-muted);
}

/* ── 言語ドロップダウン ── */
.acct-language-dropdown {
    font-size: 26px;
    height: 60px;
    border-radius: 10px;
    border-width: 0;
    background-color: var(--lpw-surface-sunken);
    color: var(--lpw-text);
}

.acct-language-dropdown > .unity-base-field__label {
    display: none;
}

/* ── プロバイダーリスト ── */
.acct-provider-list {
    padding: 8px 20px;
}

.provider-row {
    flex-direction: row;
    align-items: center;
    height: 64px;
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.provider-label {
    font-size: 26px;
    color: var(--lpw-text);
}

.provider-status-linked {
    font-size: 22px;
    color: var(--lpw-success);
    margin-right: 12px;
}

.provider-btn-unlink {
    height: 50px;
    font-size: 22px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--lpw-danger);
    background-color: transparent;
    color: var(--lpw-danger-text);
    padding: 0 16px;
}

.provider-btn-unlink:disabled {
    border-color: var(--lpw-border);
    color: var(--lpw-text-muted);
}

.provider-btn-link {
    height: 50px;
    font-size: 22px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--lpw-accent);
    background-color: transparent;
    color: var(--lpw-accent-text);
    padding: 0 16px;
}

/* ── リンクボタン ── */
.acct-link-btn {
    background-color: transparent;
    color: var(--lpw-accent-text);
    font-size: 26px;
    height: 60px;
    border-width: 0;
    -unity-text-align: middle-left;
    padding: 0;
}

/* ── アカウント削除 ── */
.acct-delete-area {
    margin-top: 40px;
    align-items: center;
    padding-bottom: 20px;
}

.acct-delete-btn {
    background-color: transparent;
    color: var(--lpw-danger-text);
    font-size: 24px;
    border-width: 0;
    height: 50px;
}

/* ── 確認ダイアログ ── */
.acct-dialog-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--lpw-scrim);
    align-items: center;
    justify-content: center;
}

.acct-dialog-box {
    background-color: var(--lpw-surface);
    border-radius: 18px;
    padding: 30px 28px;
    margin: 24px;
    max-width: 600px;
}

.acct-dialog-title {
    font-size: 28px;
    color: var(--lpw-text);
    -unity-font-style: bold;
    margin-bottom: 18px;
    -unity-text-align: middle-center;
}

.acct-dialog-body {
    font-size: 22px;
    color: var(--lpw-text-secondary);
    white-space: normal;
    margin-bottom: 28px;
    -unity-text-align: upper-left;
}

.acct-dialog-btn-confirm {
    height: 60px;
    font-size: 24px;
    border-radius: 12px;
    border-width: 0;
    background-color: var(--lpw-danger);
    color: var(--lpw-text-on-status);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.acct-dialog-btn-cancel {
    height: 60px;
    font-size: 24px;
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--lpw-border-strong);
    background-color: transparent;
    color: var(--lpw-text-secondary);
}
