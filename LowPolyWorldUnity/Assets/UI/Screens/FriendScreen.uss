.overlay-hidden {
    display: none;
}

.screen-root {
    flex-grow: 1;
    background-color: var(--lpw-bg-page);
}

.screen-header {
    flex-direction: row;
    align-items: center;
    padding: 20px 16px 12px 16px;
    background-color: var(--lpw-surface);
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.btn-back {
    width: 60px;
    height: 60px;
    background-color: transparent;
    color: var(--lpw-accent-text);
    font-size: 36px;
    border-width: 0;
}

.screen-title {
    flex-grow: 1;
    color: var(--lpw-text);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.btn-friends-rooms {
    height: 52px;
    background-color: transparent;
    color: var(--lpw-accent-text);
    font-size: 22px;
    border-width: 1px;
    border-color: var(--lpw-accent);
    border-radius: 10px;
    padding: 0 12px;
}

.tab-bar {
    flex-direction: row;
    background-color: var(--lpw-surface);
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.tab-btn {
    flex-grow: 1;
    height: 72px;
    background-color: transparent;
    color: var(--lpw-text-muted);
    font-size: 24px;
    border-width: 0;
    border-bottom-width: 3px;
    border-color: transparent;
}

.tab-btn--active {
    color: var(--lpw-accent-text);
    border-color: var(--lpw-accent);
}

.search-bar {
    flex-direction: row;
    padding: 12px 16px;
    background-color: var(--lpw-surface);
}

.search-field {
    flex-grow: 1;
    height: 60px;
    background-color: var(--lpw-surface-sunken);
    color: var(--lpw-text);
    font-size: 24px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--lpw-border);
    padding: 0 12px;
    margin-right: 10px;
}

.btn-search {
    width: 120px;
    height: 60px;
    background-color: var(--lpw-accent);
    color: var(--lpw-text-on-accent);
    font-size: 24px;
    border-radius: 10px;
    border-width: 0;
}

.user-list {
    flex-grow: 1;
}

.user-row {
    flex-direction: row;
    align-items: center;
    padding: 16px 20px;
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.user-row:hover {
    background-color: var(--lpw-surface-hover);
}

.user-avatar-placeholder {
    width: 64px;
    height: 64px;
    background-color: var(--lpw-surface-sunken);
    border-radius: 32px;
    font-size: 32px;
    color: var(--lpw-text-muted);
    -unity-text-align: middle-center;
    margin-right: 16px;
    flex-shrink: 0;
}

.user-info {
    flex-grow: 1;
}

.user-name-row {
    flex-direction: row;
    align-items: center;
}

.user-display-name {
    color: var(--lpw-text);
    font-size: 26px;
    -unity-font-style: bold;
}

.verified-badge {
    font-size: 16px;
    color: var(--lpw-text-on-accent);
    background-color: var(--lpw-accent);
    border-radius: 10px;
    padding: 1px 6px;
    margin-left: 6px;
}

.user-at-name {
    color: var(--lpw-text-muted);
    font-size: 21px;
}

.btn-action-small {
    height: 56px;
    font-size: 22px;
    border-radius: 10px;
    border-width: 0;
    padding: 0 16px;
    margin-left: 8px;
}

.btn-action-small--danger {
    background-color: var(--lpw-danger-subtle);
    color: var(--lpw-danger-text);
}

.btn-action-small--secondary {
    background-color: var(--lpw-surface-sunken);
    color: var(--lpw-text-secondary);
}

.btn-action-small--accent {
    background-color: var(--lpw-success);
    color: var(--lpw-text-on-status);
}

.empty-state {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
}

.empty-label {
    color: var(--lpw-text-muted);
    font-size: 26px;
}
