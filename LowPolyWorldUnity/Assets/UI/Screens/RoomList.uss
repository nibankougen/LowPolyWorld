.room-list-root {
    flex: 1;
    flex-direction: column;
    background-color: var(--lpw-bg-page);
}

/* ── Header ──────────────────────────────────────── */

.room-list-header {
    flex-direction: row;
    align-items: center;
    height: 52px;
    background-color: var(--lpw-surface);
    border-bottom-width: 1px;
    border-bottom-color: var(--lpw-border);
    padding: 0 8px;
}

.btn-back {
    width: 44px;
    height: 44px;
    background-color: transparent;
    border-width: 0;
    font-size: 24px;
    color: var(--lpw-text-secondary);
}

.header-title {
    flex: 1;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--lpw-text);
    -unity-text-align: middle-center;
}

.header-spacer {
    width: 44px;
}

/* ── Loading ─────────────────────────────────────── */

.room-loading {
    align-items: center;
    padding: 20px;
}

.loading-label {
    font-size: 14px;
    color: var(--lpw-text-muted);
}

/* ── Room list ───────────────────────────────────── */

.room-scroll {
    flex: 1;
}

.room-items {
    flex-direction: column;
    padding: 8px;
}

.room-card {
    flex-direction: row;
    align-items: center;
    background-color: var(--lpw-surface);
    border-radius: 10px;
    margin-bottom: 8px;
    padding: 12px 14px;
    height: 56px;
}

.room-card__lang {
    width: 36px;
    font-size: 13px;
    color: var(--lpw-text-secondary);
    -unity-text-align: middle-center;
}

.room-card__players {
    flex: 1;
    font-size: 14px;
    color: var(--lpw-text-secondary);
    margin-left: 8px;
}

.room-card__join-btn {
    height: 34px;
    width: 72px;
    border-radius: 17px;
    background-color: var(--lpw-accent);
    border-width: 0;
    color: var(--lpw-text-on-accent);
    font-size: 13px;
}

.room-card__join-btn--full {
    background-color: var(--lpw-surface-sunken);
    color: var(--lpw-text-muted);
}

.room-card__badge {
    font-size: 11px;
    color: var(--lpw-text-muted);
    margin-right: 6px;
}

/* ── Empty ───────────────────────────────────────── */

.room-empty {
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.room-empty-label {
    font-size: 14px;
    color: var(--lpw-text-muted);
}

/* ── Create area ─────────────────────────────────── */

.create-area {
    flex-direction: column;
    padding: 12px 16px;
    border-top-width: 1px;
    border-top-color: var(--lpw-border);
    background-color: var(--lpw-surface);
}

.btn-create {
    height: 46px;
    border-radius: 23px;
    font-size: 14px;
    margin-bottom: 8px;
}

.btn-create--primary {
    background-color: var(--lpw-accent);
    border-width: 0;
    color: var(--lpw-text-on-accent);
}

.btn-create--secondary {
    background-color: var(--lpw-accent-subtle);
    border-width: 0;
    color: var(--lpw-accent-text);
}

.btn-create--outline {
    background-color: transparent;
    border-width: 1px;
    border-color: var(--lpw-border-strong);
    color: var(--lpw-text-secondary);
    margin-bottom: 0;
}
