.title-root {
    flex: 1;
    align-items: center;
    justify-content: center;
    background-color: var(--lpw-bg-page);
}

.logo-area {
    align-items: center;
    margin-bottom: 48px;
}

.app-title {
    font-size: 36px;
    color: var(--lpw-text);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.app-subtitle {
    font-size: 14px;
    color: var(--lpw-text-secondary);
}

.loading-area {
    align-items: center;
}

.loading-label {
    font-size: 16px;
    color: var(--lpw-text-secondary);
}

/* ── Login modal ─────────────────────────────────── */

.login-modal,
.name-setup-modal,
.update-modal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--lpw-scrim);
}

.login-modal__inner,
.name-setup-modal__inner,
.update-modal__inner {
    background-color: var(--lpw-surface);
    border-radius: 16px;
    padding: 32px 24px;
    width: 320px;
    align-items: stretch;
}

.login-modal__title,
.name-setup-modal__title,
.update-modal__title {
    font-size: 20px;
    color: var(--lpw-text);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.consent-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.consent-toggle {
    margin-right: 8px;
}

.consent-label {
    flex: 1;
    font-size: 13px;
    color: var(--lpw-text-secondary);
}

.consent-link {
    background-color: transparent;
    border-width: 0;
    color: var(--lpw-accent-text);
    font-size: 12px;
    padding: 2px 4px;
}

.signin-btn {
    margin-top: 12px;
    height: 48px;
    border-radius: 8px;
    font-size: 15px;
    -unity-font-style: bold;
    border-width: 0;
}

/* ソーシャルサインインはブランド指定色のためトークン化しない（テーマ非依存） */
.signin-btn--google {
    background-color: rgb(255, 255, 255);
    color: rgb(40, 40, 40);
}

.signin-btn--apple {
    background-color: rgb(20, 20, 20);
    color: rgb(255, 255, 255);
}

.signin-btn:disabled {
    opacity: 0.4;
}

/* ── Name setup ──────────────────────────────────── */

.name-setup-modal__desc {
    font-size: 13px;
    color: var(--lpw-text-muted);
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.name-input {
    height: 44px;
    border-radius: 8px;
    margin-bottom: 8px;
    font-size: 16px;
    background-color: var(--lpw-surface-sunken);
    border-color: var(--lpw-border-strong);
    color: var(--lpw-text);
}

.name-error {
    font-size: 12px;
    color: var(--lpw-danger-text);
    margin-bottom: 8px;
}

/* ── Common buttons ──────────────────────────────── */

.btn-primary {
    height: 48px;
    margin-top: 8px;
    border-radius: 8px;
    font-size: 16px;
    -unity-font-style: bold;
    border-width: 0;
    background-color: var(--lpw-accent);
    color: var(--lpw-text-on-accent);
}

.btn-secondary {
    height: 44px;
    margin-top: 8px;
    border-radius: 8px;
    font-size: 15px;
    border-width: 1px;
    border-color: var(--lpw-border-strong);
    background-color: transparent;
    color: var(--lpw-text-secondary);
}

/* ── Error area ──────────────────────────────────── */

.error-area {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 80px;
    align-items: center;
}

.error-label {
    font-size: 14px;
    color: var(--lpw-danger-text);
    margin-bottom: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 300px;
}

/* ── Update modal ────────────────────────────────── */

.update-modal__desc {
    font-size: 14px;
    color: var(--lpw-text-secondary);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 16px;
}
