.world-tab-root {
    flex: 1;
    flex-direction: column;
    background-color: var(--lpw-bg-page);
}

/* ── Search bar ──────────────────────────────────── */

.search-bar {
    padding: 10px 12px 6px;
}

.search-input {
    height: 40px;
    border-radius: 20px;
    background-color: var(--lpw-surface-sunken);
    border-color: var(--lpw-border);
    color: var(--lpw-text);
    font-size: 14px;
}

/* ── Tag filter ─────────────────────────────────── */

.tag-filter-area {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px 6px;
    background-color: var(--lpw-surface);
}

.tag-filter-scroll {
    flex: 1;
}

.tag-filter-chips {
    flex-direction: row;
    padding: 2px 0;
}

.tag-chip {
    height: 28px;
    padding: 0 12px;
    margin-right: 6px;
    border-radius: 14px;
    background-color: var(--lpw-surface-sunken);
    border-width: 1px;
    border-color: var(--lpw-border);
    color: var(--lpw-text-secondary);
    font-size: 13px;
}

.tag-chip--active {
    background-color: var(--lpw-accent);
    border-color: var(--lpw-accent);
    color: var(--lpw-text-on-accent);
}

.btn-tag-clear {
    width: 32px;
    height: 32px;
    background-color: transparent;
    border-width: 0;
    color: var(--lpw-text-muted);
    font-size: 16px;
    margin-left: 4px;
}

/* ── Sub-tab bar ─────────────────────────────────── */

.sub-tab-bar {
    flex-direction: row;
    background-color: var(--lpw-surface);
    border-bottom-width: 1px;
    border-bottom-color: var(--lpw-border);
}

.sub-tab {
    flex: 1;
    height: 40px;
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    color: var(--lpw-text-muted);
    font-size: 13px;
}

.sub-tab--active {
    color: var(--lpw-text);
    border-bottom-color: var(--lpw-accent);
}

/* ── World list ──────────────────────────────────── */

.world-scroll {
    flex: 1;
}

.world-list {
    flex-direction: column;
    padding: 8px;
}

/* ── World card ──────────────────────────────────── */

.world-card {
    flex-direction: row;
    background-color: var(--lpw-surface);
    border-radius: 12px;
    margin-bottom: 10px;
    height: 90px;
    overflow: hidden;
}

.world-card__thumb {
    width: 90px;
    height: 90px;
    background-color: var(--lpw-surface-sunken);
}

.world-card__info {
    flex: 1;
    padding: 10px 12px;
    flex-direction: column;
    justify-content: space-between;
}

.world-card__name {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--lpw-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.world-card__meta {
    flex-direction: row;
    align-items: center;
}

.world-card__players {
    font-size: 12px;
    color: var(--lpw-success);
    margin-right: 12px;
}

.world-card__likes {
    font-size: 12px;
    color: var(--lpw-danger-text);
}

/* ── Load more / empty ───────────────────────────── */

.load-more-area {
    align-items: center;
    padding: 16px;
}

.load-more-label {
    font-size: 13px;
    color: var(--lpw-text-muted);
}

.empty-area {
    flex: 1;
    align-items: center;
    justify-content: center;
}

.empty-label {
    font-size: 15px;
    color: var(--lpw-text-muted);
}
