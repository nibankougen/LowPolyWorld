.overlay-hidden {
    display: none;
}

.world-manage-root {
    flex-grow: 1;
    background-color: var(--lpw-bg-page);
    flex-direction: column;
}

/* ── タブバー ── */
.category-tab-bar {
    flex-direction: row;
    background-color: var(--lpw-surface);
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.category-tab {
    flex-grow: 1;
    height: 72px;
    background-color: transparent;
    color: var(--lpw-text-muted);
    font-size: 20px;
    border-width: 0;
    border-radius: 0;
    padding: 0 4px;
}

.category-tab--active {
    color: var(--lpw-accent-text);
    border-bottom-width: 2px;
    border-color: var(--lpw-accent);
}

/* ── タブパネル共通 ── */
.tab-panel {
    flex-grow: 1;
    flex-direction: column;
}

/* ── スロット使用状況 ── */
.slot-usage-bar {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding: 8px 20px;
}

.slot-usage-label {
    color: var(--lpw-text-muted);
    font-size: 22px;
}

/* ── ワールドグリッド ── */
.world-grid {
    flex-grow: 1;
    flex-direction: column;
}

.world-grid > .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 12px;
}

/* ── ワールドカード ── */
.world-card {
    width: 48%;
    margin: 1%;
    background-color: var(--lpw-surface);
    border-radius: 12px;
    overflow: hidden;
}

.world-card__thumbnail {
    width: 100%;
    height: 160px;
    background-color: var(--lpw-surface-sunken);
}

.world-card__footer {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
}

.world-card__name {
    flex-grow: 1;
    color: var(--lpw-text);
    font-size: 22px;
    -unity-text-overflow-position: end;
    overflow: hidden;
    white-space: nowrap;
}

.world-card__badge {
    font-size: 18px;
    padding: 2px 8px;
    border-radius: 6px;
    color: var(--lpw-text-on-status);
}

.world-card__badge--public {
    background-color: var(--lpw-success);
}

.world-card__badge--private {
    background-color: var(--lpw-text-secondary);
}

.world-card__badge--unpublished {
    background-color: var(--lpw-text-muted);
}

.world-card__locked-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--lpw-scrim);
    align-items: center;
    justify-content: center;
}

.world-card__lock-icon {
    color: var(--lpw-text-on-status);
    font-size: 36px;
}

/* ── 新規作成カード ── */
.world-card--new {
    background-color: var(--lpw-surface-muted);
    border-width: 2px;
    border-color: var(--lpw-border-strong);
    border-style: solid;
    align-items: center;
    justify-content: center;
    min-height: 200px;
}

.world-card__new-icon {
    color: var(--lpw-accent-text);
    font-size: 52px;
    margin-bottom: 8px;
}

.world-card__new-label {
    color: var(--lpw-accent-text);
    font-size: 22px;
}

/* ── 空状態 ── */
.empty-state {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.empty-label {
    color: var(--lpw-text-muted);
    font-size: 26px;
    margin-bottom: 12px;
}

.empty-hint {
    color: var(--lpw-text-muted);
    font-size: 20px;
    -unity-text-align: middle-center;
}

/* ── スタブパネル ── */
.stub-label {
    flex-grow: 1;
    color: var(--lpw-text-muted);
    font-size: 22px;
    -unity-text-align: middle-center;
    padding: 40px;
}
