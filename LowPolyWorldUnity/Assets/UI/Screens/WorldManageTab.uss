.overlay-hidden {
    display: none;
}

.world-manage-root {
    flex-grow: 1;
    background-color: rgb(18, 18, 22);
    flex-direction: column;
}

/* ── タブバー ── */
.category-tab-bar {
    flex-direction: row;
    background-color: rgb(24, 24, 30);
    border-bottom-width: 1px;
    border-color: rgb(44, 44, 54);
}

.category-tab {
    flex-grow: 1;
    height: 72px;
    background-color: transparent;
    color: rgb(140, 140, 155);
    font-size: 20px;
    border-width: 0;
    border-radius: 0;
    padding: 0 4px;
}

.category-tab--active {
    color: rgb(100, 170, 255);
    border-bottom-width: 2px;
    border-color: rgb(100, 170, 255);
}

/* ── タブパネル共通 ── */
.tab-panel {
    flex-grow: 1;
    flex-direction: column;
}

/* ── スロット使用状況 ── */
.slot-usage-bar {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding: 8px 20px;
}

.slot-usage-label {
    color: rgb(140, 140, 155);
    font-size: 22px;
}

/* ── ワールドグリッド ── */
.world-grid {
    flex-grow: 1;
    flex-direction: column;
}

.world-grid > .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 12px;
}

/* ── ワールドカード ── */
.world-card {
    width: 48%;
    margin: 1%;
    background-color: rgb(30, 30, 38);
    border-radius: 12px;
    overflow: hidden;
}

.world-card__thumbnail {
    width: 100%;
    height: 160px;
    background-color: rgb(44, 44, 54);
}

.world-card__footer {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
}

.world-card__name {
    flex-grow: 1;
    color: white;
    font-size: 22px;
    -unity-text-overflow-position: end;
    overflow: hidden;
    white-space: nowrap;
}

.world-card__badge {
    font-size: 18px;
    padding: 2px 8px;
    border-radius: 6px;
    color: white;
}

.world-card__badge--public {
    background-color: rgb(40, 160, 80);
}

.world-card__badge--private {
    background-color: rgb(80, 80, 95);
}

.world-card__badge--unpublished {
    background-color: rgb(60, 60, 75);
}

.world-card__locked-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.world-card__lock-icon {
    color: rgb(200, 200, 200);
    font-size: 36px;
}

/* ── 新規作成カード ── */
.world-card--new {
    background-color: rgb(24, 24, 30);
    border-width: 2px;
    border-color: rgb(60, 60, 80);
    border-style: solid;
    align-items: center;
    justify-content: center;
    min-height: 200px;
}

.world-card__new-icon {
    color: rgb(100, 170, 255);
    font-size: 52px;
    margin-bottom: 8px;
}

.world-card__new-label {
    color: rgb(100, 170, 255);
    font-size: 22px;
}

/* ── 空状態 ── */
.empty-state {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.empty-label {
    color: rgb(140, 140, 155);
    font-size: 26px;
    margin-bottom: 12px;
}

.empty-hint {
    color: rgb(90, 90, 105);
    font-size: 20px;
    -unity-text-align: middle-center;
}

/* ── スタブパネル ── */
.stub-label {
    flex-grow: 1;
    color: rgb(90, 90, 105);
    font-size: 22px;
    -unity-text-align: middle-center;
    padding: 40px;
}
