<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="WorldEditor.uss" />
    <ui:VisualElement name="editor-root" class="editor-root">

        <!-- ── ヘッダー ── -->
        <ui:VisualElement class="editor-header">
            <ui:Button name="btn-back" class="editor-btn-icon" text="‹" />
            <ui:TextField name="field-world-name" class="editor-world-name"
                          placeholder-text="ワールド名を入力..." />
            <ui:Button name="btn-save" class="editor-btn-secondary" text="保存" />
            <ui:Button name="btn-publish" class="editor-btn-primary" text="公開" />
        </ui:VisualElement>

        <!-- ── ギズモバー（オブジェクト選択中のみ表示） ── -->
        <ui:VisualElement name="gizmo-bar" class="gizmo-bar overlay-hidden">
            <ui:Button name="btn-gizmo-move"  class="gizmo-btn gizmo-btn--active" text="移動" />
            <ui:Button name="btn-gizmo-scale" class="gizmo-btn" text="拡大縮小" />
            <ui:Button name="btn-gizmo-rotate" class="gizmo-btn" text="回転" />
        </ui:VisualElement>

        <!-- ── 3D ビュー領域（透過・カメラがこの後ろに描画される） ── -->
        <ui:VisualElement name="view3d-area" class="view3d-area">
            <!-- テクスチャコスト表示（右上） -->
            <ui:VisualElement class="cost-display">
                <ui:VisualElement class="cost-bar-track">
                    <ui:VisualElement name="cost-bar-fill" class="cost-bar-fill" />
                </ui:VisualElement>
                <ui:Label name="cost-label" class="cost-label" text="0 / 4096" />
            </ui:VisualElement>

            <!-- 地形タブ用オーバーレイ（地形タブ選択中のみ表示） -->
            <ui:VisualElement name="terrain-view-overlay" class="terrain-view-overlay overlay-hidden"
                              picking-mode="Ignore">
                <!-- 上方非表示トグル（左上） -->
                <ui:Button name="terrain-btn-hide-above" class="terrain-hide-above" text="上方非表示" />
                <!-- 高さバー（右側） -->
                <ui:VisualElement class="terrain-height-bar">
                    <ui:Button name="terrain-height-up" class="terrain-height-btn" text="▲" />
                    <ui:Label name="terrain-height-label" class="terrain-height-label" text="0" />
                    <ui:Button name="terrain-height-down" class="terrain-height-btn" text="▼" />
                </ui:VisualElement>
                <!-- フラッシュメッセージ（中央下） -->
                <ui:Label name="terrain-flash" class="terrain-flash overlay-hidden" text="" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ── 下部タブバー ── -->
        <ui:VisualElement class="bottom-tab-bar">
            <ui:Button name="tab-terrain"  class="bottom-tab" text="地形" />
            <ui:Button name="tab-objects"  class="bottom-tab bottom-tab--active" text="オブジェクト" />
            <ui:Button name="tab-gimmicks" class="bottom-tab" text="ギミック" />
            <ui:Button name="tab-settings" class="bottom-tab" text="設定" />
            <ui:Button name="btn-minimize" class="bottom-tab-minimize" text="▽" />
        </ui:VisualElement>

        <!-- ── タブコンテンツ ── -->
        <ui:VisualElement name="tab-content" class="tab-content">

            <!-- ───── 地形タブ ───── -->
            <ui:VisualElement name="panel-terrain" class="tab-panel overlay-hidden">

                <!-- 編集バー（アイコンボタン） -->
                <ui:VisualElement class="terrain-edit-bar">
                    <ui:Button name="terrain-mode-brush"  class="terrain-mode-btn terrain-icon terrain-icon--brush terrain-mode-btn--active" tooltip="ブラシ" />
                    <ui:Button name="terrain-mode-eraser" class="terrain-mode-btn terrain-icon terrain-icon--eraser" tooltip="消しゴム" />
                    <ui:Button name="terrain-mode-shape"  class="terrain-mode-btn terrain-icon terrain-icon--shape" tooltip="図形" />
                    <ui:Button name="terrain-mode-type"   class="terrain-mode-btn terrain-icon terrain-icon--type" tooltip="タイプ変更" />
                    <ui:Button name="terrain-mode-select" class="terrain-mode-btn terrain-icon terrain-icon--select" tooltip="範囲選択" />
                    <ui:Button name="terrain-mode-move"   class="terrain-mode-btn terrain-icon terrain-icon--move" tooltip="移動" />
                    <ui:Button name="terrain-btn-copy"  class="terrain-action-btn terrain-action-btn--icon terrain-icon terrain-icon--copy overlay-hidden" tooltip="コピー" />
                    <ui:Button name="terrain-btn-paste" class="terrain-action-btn overlay-hidden" text="ペースト" />
                </ui:VisualElement>

                <!-- 範囲選択の選択方法表示（範囲選択モード時のみ） -->
                <ui:Label name="terrain-select-method" class="terrain-select-method overlay-hidden"
                          text="選択方法: 四角形（ボタン再タップで切替）" />

                <!-- 地形サブタブ -->
                <ui:VisualElement class="terrain-subtab-bar">
                    <ui:Button name="terrain-subtab-used"  class="terrain-subtab terrain-subtab--active" text="利用中地形" />
                    <ui:Button name="terrain-subtab-saved" class="terrain-subtab" text="保存・編集地形" />
                    <ui:Button name="terrain-subtab-owned" class="terrain-subtab" text="所有地形" />
                </ui:VisualElement>

                <!-- 地形一覧 -->
                <ui:ScrollView class="terrain-list-scroll">
                    <ui:VisualElement name="terrain-list" class="terrain-list" />
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- ───── オブジェクトタブ ───── -->
            <ui:VisualElement name="panel-objects" class="tab-panel">

                <!-- 固定ヘッダー: オブジェクト数 -->
                <ui:VisualElement class="object-header">
                    <ui:Label class="object-header-label" text="オブジェクト数" />
                    <ui:Label name="object-count-label" class="object-count-label" text="0 / 400" />
                </ui:VisualElement>

                <!-- 選択ツールバー（オブジェクト選択中のみ表示） -->
                <ui:VisualElement name="object-selection-bar" class="object-selection-bar overlay-hidden">
                    <ui:Button name="object-btn-duplicate" class="object-action-btn" text="複製" />
                    <ui:Button name="object-btn-delete" class="object-action-btn" text="削除" />
                    <ui:VisualElement class="object-scale-group">
                        <ui:Label class="object-scale-axis" text="W" />
                        <ui:Button name="object-scale-w-dec" class="object-scale-btn" text="−" />
                        <ui:Label name="object-scale-w-label" class="object-scale-label" text="1m" />
                        <ui:Button name="object-scale-w-inc" class="object-scale-btn" text="+" />
                    </ui:VisualElement>
                    <ui:VisualElement class="object-scale-group">
                        <ui:Label class="object-scale-axis" text="D" />
                        <ui:Button name="object-scale-d-dec" class="object-scale-btn" text="−" />
                        <ui:Label name="object-scale-d-label" class="object-scale-label" text="1m" />
                        <ui:Button name="object-scale-d-inc" class="object-scale-btn" text="+" />
                    </ui:VisualElement>
                    <ui:VisualElement class="object-scale-group">
                        <ui:Label class="object-scale-axis" text="H" />
                        <ui:Button name="object-scale-h-dec" class="object-scale-btn" text="−" />
                        <ui:Label name="object-scale-h-label" class="object-scale-label" text="1m" />
                        <ui:Button name="object-scale-h-inc" class="object-scale-btn" text="+" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- サブタブ -->
                <ui:VisualElement class="object-subtab-bar">
                    <ui:Button name="object-subtab-used"  class="object-subtab" text="利用中" />
                    <ui:Button name="object-subtab-saved" class="object-subtab" text="保存・編集" />
                    <ui:Button name="object-subtab-owned" class="object-subtab object-subtab--active" text="所有" />
                </ui:VisualElement>

                <!-- 利用中オブジェクト一覧 -->
                <ui:VisualElement name="object-used-container" class="object-subtab-content overlay-hidden">
                    <ui:ScrollView class="object-list-scroll">
                        <ui:VisualElement name="object-used-list" class="object-list" />
                    </ui:ScrollView>
                </ui:VisualElement>

                <!-- 保存・編集オブジェクト（スタブ） -->
                <ui:VisualElement name="object-saved-container" class="object-subtab-content overlay-hidden">
                    <ui:Label class="stub-label" text="保存・編集オブジェクト（実装予定）" />
                </ui:VisualElement>

                <!-- 所有オブジェクトパレット -->
                <ui:VisualElement name="object-owned-container" class="object-subtab-content">
                    <ui:ScrollView class="object-list-scroll">
                        <ui:VisualElement name="object-owned-list" class="object-list" />
                    </ui:ScrollView>
                </ui:VisualElement>

                <!-- フラッシュメッセージ -->
                <ui:Label name="object-flash" class="object-flash overlay-hidden" text="" />
            </ui:VisualElement>

            <!-- ───── ギミックタブ ───── -->
            <ui:VisualElement name="panel-gimmicks" class="tab-panel overlay-hidden">

                <!-- 固定ヘッダー: ルール・グループ合計 -->
                <ui:VisualElement class="object-header">
                    <ui:Label class="object-header-label" text="ルール・グループ合計" />
                    <ui:Label name="gimmick-total-label" class="object-count-label" text="0 / 100" />
                </ui:VisualElement>

                <ui:ScrollView class="gimmick-scroll">

                    <!-- ステート定義エリア（折りたたみ可） -->
                    <ui:VisualElement class="gimmick-section">
                        <ui:Button name="gimmick-states-toggle" class="gimmick-collapse-header" text="▼ ステート定義" />
                        <ui:VisualElement name="gimmick-states-body" class="gimmick-states-body">
                            <ui:Label class="gimmick-subhead" text="ワールドステート（0〜9）" />
                            <ui:VisualElement name="gimmick-world-states" class="gimmick-state-list" />
                            <ui:Label class="gimmick-subhead" text="プレイヤーステート（0〜3）" />
                            <ui:VisualElement name="gimmick-player-states" class="gimmick-state-list" />
                            <ui:Label class="gimmick-subhead" text="タイマー（0〜4）" />
                            <ui:VisualElement name="gimmick-timer-states" class="gimmick-state-list" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ルール一覧 -->
                    <ui:VisualElement class="gimmick-section">
                        <ui:VisualElement class="gimmick-rules-header">
                            <ui:Label class="gimmick-subhead" text="ルール" />
                            <ui:Button name="gimmick-add-rule" class="gimmick-add-btn gimmick-icon-btn gimmick-icon-btn--plus" text="" />
                        </ui:VisualElement>
                        <ui:VisualElement name="gimmick-rule-list" class="gimmick-rule-list" />
                    </ui:VisualElement>

                </ui:ScrollView>

                <!-- フラッシュメッセージ -->
                <ui:Label name="gimmick-flash" class="object-flash overlay-hidden" text="" />

                <!-- ルール編集画面（タップでタブ拡大・オーバーレイ） -->
                <ui:VisualElement name="gimmick-rule-editor" class="gimmick-rule-editor overlay-hidden">
                    <ui:VisualElement class="gimmick-edit-header">
                        <ui:Button name="rule-edit-back" class="gimmick-edit-back" text="＜" />
                        <ui:TextField name="rule-edit-title" class="gimmick-edit-title" />
                    </ui:VisualElement>

                    <ui:ScrollView class="gimmick-edit-scroll">
                        <!-- 入力イベント（OR 結合） -->
                        <ui:VisualElement class="gimmick-edit-section">
                            <ui:VisualElement class="gimmick-edit-section-head">
                                <ui:Label class="gimmick-subhead" text="入力イベント（いずれか発火 / 最大 20）" />
                                <ui:Button name="rule-edit-add-trigger" class="gimmick-add-btn gimmick-icon-btn gimmick-icon-btn--plus" text="" />
                            </ui:VisualElement>
                            <ui:VisualElement name="rule-edit-trigger-list" class="gimmick-edit-list" />
                        </ui:VisualElement>

                        <!-- 条件（AND 結合） -->
                        <ui:VisualElement class="gimmick-edit-section">
                            <ui:VisualElement class="gimmick-edit-section-head">
                                <ui:Label class="gimmick-subhead" text="条件（すべて満たす / 最大 20）" />
                                <ui:Button name="rule-edit-add-condition" class="gimmick-add-btn gimmick-icon-btn gimmick-icon-btn--plus" text="" />
                            </ui:VisualElement>
                            <ui:VisualElement name="rule-edit-condition-list" class="gimmick-edit-list" />
                        </ui:VisualElement>

                        <!-- アクション（順番に実行） -->
                        <ui:VisualElement class="gimmick-edit-section">
                            <ui:VisualElement class="gimmick-edit-section-head">
                                <ui:Label class="gimmick-subhead" text="アクション（順番に実行 / 最大 20）" />
                                <ui:Button name="rule-edit-add-action" class="gimmick-add-btn gimmick-icon-btn gimmick-icon-btn--plus" text="" />
                            </ui:VisualElement>
                            <ui:VisualElement name="rule-edit-action-list" class="gimmick-edit-list" />
                        </ui:VisualElement>
                    </ui:ScrollView>

                    <ui:Label name="rule-edit-flash" class="object-flash overlay-hidden" text="" />
                </ui:VisualElement>

                <!-- 種類選択リスト（カテゴリ見出し付き・オーバーレイ） -->
                <ui:VisualElement name="gimmick-type-picker" class="gimmick-rule-editor overlay-hidden">
                    <ui:VisualElement class="gimmick-edit-header">
                        <ui:Button name="type-picker-back" class="gimmick-edit-back" text="＜" />
                        <ui:Label name="type-picker-title" class="gimmick-picker-title" text="種類を選択" />
                    </ui:VisualElement>
                    <ui:ScrollView name="type-picker-list" class="gimmick-edit-scroll" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- ───── 設定タブ ───── -->
            <ui:VisualElement name="panel-settings" class="tab-panel overlay-hidden">
                <ui:ScrollView class="settings-scroll">

                    <!-- テストプレイ -->
                    <ui:VisualElement class="settings-section">
                        <ui:Button name="btn-test-play" class="btn-test-play" text="▶ テストプレイ" />
                    </ui:VisualElement>

                    <!-- サムネイル -->
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-label" text="サムネイル" />
                        <ui:VisualElement name="thumbnail-preview" class="thumbnail-preview">
                            <ui:Label name="thumbnail-hint" class="thumbnail-hint" text="タップして設定" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ワールド名（ヘッダーと共有・表示のみ） -->
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-label" text="ワールド名" />
                        <ui:TextField name="settings-world-name" class="settings-input"
                                      placeholder-text="ワールド名を入力..." />
                    </ui:VisualElement>

                    <!-- タグ入力 -->
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-label" text="タグ（最大 5 個）" />
                        <!-- 追加済みタグチップ一覧 -->
                        <ui:VisualElement name="tag-chips" class="tag-chips-container" />
                        <!-- タグ入力フィールド（上限到達時は非表示） -->
                        <ui:VisualElement name="tag-input-row" class="tag-input-row">
                            <ui:TextField name="field-tag-input" class="tag-input"
                                          placeholder-text="タグを入力して Enter" />
                            <ui:Button name="btn-tag-add" class="btn-tag-add" text="追加" />
                        </ui:VisualElement>
                        <ui:Label name="tag-error" class="tag-error overlay-hidden" text="" />
                    </ui:VisualElement>

                    <!-- BGM 設定 -->
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-label" text="BGM" />
                        <!-- 選択中トラック表示 -->
                        <ui:VisualElement class="bgm-current">
                            <ui:Label name="bgm-current-name" class="bgm-current-name" text="なし" />
                            <ui:Label name="bgm-current-author" class="bgm-current-author" text="" />
                        </ui:VisualElement>
                        <!-- トラックリスト -->
                        <ui:VisualElement name="bgm-track-list" class="bgm-track-list" />
                        <!-- 音量スライダー -->
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-row-label" text="音量" />
                            <ui:Slider name="slider-bgm-volume" class="settings-slider"
                                       low-value="0" high-value="100" value="100" />
                            <ui:Label name="label-bgm-volume" class="settings-row-value" text="100%" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 人数上限 -->
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-label" text="人数上限" />
                        <ui:VisualElement class="stepper-row">
                            <ui:Button name="btn-players-dec" class="stepper-btn" text="−" />
                            <ui:Label name="label-max-players" class="stepper-value" text="6" />
                            <ui:Button name="btn-players-inc" class="stepper-btn" text="＋" />
                        </ui:VisualElement>
                        <ui:Label name="label-players-hint" class="settings-hint"
                                  text="2〜6人（プレミアム: 最大24人）" />
                    </ui:VisualElement>

                    <!-- 背景設定 -->
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-label" text="背景" />
                        <ui:VisualElement class="radio-row">
                            <ui:Button name="btn-bg-solid"    class="radio-btn radio-btn--first radio-btn--active" text="単色" />
                            <ui:Button name="btn-bg-gradient" class="radio-btn" text="グラデーション" />
                            <ui:Button name="btn-bg-texture"  class="radio-btn radio-btn--last" text="テクスチャ" />
                        </ui:VisualElement>
                        <ui:VisualElement name="bg-color-row" class="settings-row">
                            <ui:Label class="settings-row-label" text="カラー" />
                            <ui:TextField name="field-bg-color" class="color-input" value="#111111" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 環境カラー -->
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-label" text="環境カラー" />
                        <ui:VisualElement class="settings-row">
                            <ui:TextField name="field-ambient-color" class="color-input" value="#FFFFFF" />
                            <ui:Label class="settings-hint" text="HSV V ≥ 0.25" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- フォグ設定 -->
                    <ui:VisualElement class="settings-section">
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="フォグ" />
                            <ui:Toggle name="toggle-fog" class="settings-toggle" />
                        </ui:VisualElement>
                        <ui:VisualElement name="fog-fields" class="overlay-hidden">
                            <ui:VisualElement class="settings-row">
                                <ui:Label class="settings-row-label" text="カラー" />
                                <ui:TextField name="field-fog-color" class="color-input" value="#E6E6E6" />
                            </ui:VisualElement>
                            <ui:VisualElement class="settings-row">
                                <ui:Label class="settings-row-label" text="開始距離" />
                                <ui:Slider name="slider-fog-start" class="settings-slider"
                                           low-value="0" high-value="100" value="10" />
                                <ui:Label name="label-fog-start" class="settings-row-value" text="10m" />
                            </ui:VisualElement>
                            <ui:VisualElement class="settings-row">
                                <ui:Label class="settings-row-label" text="終了距離" />
                                <ui:Slider name="slider-fog-end" class="settings-slider"
                                           low-value="0" high-value="200" value="50" />
                                <ui:Label name="label-fog-end" class="settings-row-value" text="50m" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- スクリーンエフェクト -->
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-label" text="スクリーンエフェクト" />
                        <ui:VisualElement class="radio-row">
                            <ui:Button name="btn-fx-none" class="radio-btn radio-btn--first radio-btn--active" text="なし" />
                            <ui:Button name="btn-fx-rain" class="radio-btn radio-btn--last" text="雨" />
                        </ui:VisualElement>
                        <ui:VisualElement name="fx-intensity-row" class="settings-row overlay-hidden">
                            <ui:Label class="settings-row-label" text="強度" />
                            <ui:Slider name="slider-fx-intensity" class="settings-slider"
                                       low-value="0" high-value="100" value="100" />
                            <ui:Label name="label-fx-intensity" class="settings-row-value" text="100%" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 公開/非公開 -->
                    <ui:VisualElement class="settings-section">
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="公開" />
                            <ui:Toggle name="toggle-public" class="settings-toggle" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- バージョン情報 -->
                    <ui:VisualElement class="settings-section">
                        <ui:Label name="label-version" class="version-label" text="未公開" />
                    </ui:VisualElement>

                    <!-- 公開ボタン -->
                    <ui:VisualElement class="settings-section">
                        <ui:Button name="btn-publish-settings" class="btn-publish-full"
                                   text="新しいバージョンを公開" />
                        <!-- 公開エラー一覧 -->
                        <ui:VisualElement name="publish-errors" class="publish-errors overlay-hidden" />
                    </ui:VisualElement>

                    <!-- バックアップ（プレミアムのみ表示） -->
                    <ui:VisualElement name="backup-section" class="settings-section overlay-hidden">
                        <ui:Label class="settings-label" text="バックアップ（プレミアム）" />
                        <ui:Button name="btn-backup-save"    class="editor-btn-secondary" text="バックアップを保存" />
                        <ui:Button name="btn-backup-restore" class="editor-btn-secondary" text="バックアップを復元" />
                    </ui:VisualElement>

                </ui:ScrollView>
            </ui:VisualElement>

        </ui:VisualElement><!-- end tab-content -->

    </ui:VisualElement>
</ui:UXML>
