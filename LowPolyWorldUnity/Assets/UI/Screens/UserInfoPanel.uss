.overlay-hidden {
    display: none;
}

.uip-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--lpw-scrim);
    align-items: center;
    justify-content: center;
}

.uip-panel {
    background-color: var(--lpw-surface);
    border-radius: 20px;
    width: 480px;
    padding: 28px 24px 24px 24px;
    align-items: center;
    position: relative;
}

.uip-close-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 52px;
    height: 52px;
    background-color: var(--lpw-surface-sunken);
    color: var(--lpw-text-secondary);
    font-size: 28px;
    border-radius: 8px;
    border-width: 0;
}

.uip-avatar-icon {
    width: 120px;
    height: 120px;
    background-color: var(--lpw-surface-sunken);
    border-radius: 60px;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
}

.uip-avatar-placeholder {
    font-size: 60px;
    color: var(--lpw-text-muted);
}

.uip-name-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.uip-display-name {
    color: var(--lpw-text);
    font-size: 32px;
    -unity-font-style: bold;
}

.uip-verified-badge {
    font-size: 18px;
    color: var(--lpw-text-on-accent);
    background-color: var(--lpw-accent);
    border-radius: 10px;
    padding: 2px 8px;
    margin-left: 8px;
}

.uip-at-name {
    color: var(--lpw-text-muted);
    font-size: 24px;
    margin-bottom: 18px;
}

.uip-social-row {
    flex-direction: row;
    margin-bottom: 20px;
}

.uip-social-btn {
    flex-direction: column;
    align-items: center;
    background-color: transparent;
    border-width: 0;
    padding: 8px 24px;
}

.uip-social-count {
    color: var(--lpw-text);
    font-size: 30px;
    -unity-font-style: bold;
}

.uip-social-label {
    color: var(--lpw-text-muted);
    font-size: 20px;
}

.uip-actions {
    width: 100%;
    margin-top: 4px;
}

.uip-action-btn {
    width: 100%;
    height: 68px;
    font-size: 26px;
    border-radius: 12px;
    border-width: 0;
    margin-bottom: 10px;
}

.uip-action-btn--primary {
    background-color: var(--lpw-accent);
    color: var(--lpw-text-on-accent);
}

.uip-action-btn--secondary {
    background-color: var(--lpw-surface-sunken);
    color: var(--lpw-text-secondary);
}

.uip-action-btn--accent {
    background-color: var(--lpw-success);
    color: var(--lpw-text-on-status);
}

.uip-action-btn--more {
    background-color: var(--lpw-surface-sunken);
    color: var(--lpw-text-secondary);
    letter-spacing: 4px;
}

.uip-more-menu {
    width: 100%;
    background-color: var(--lpw-surface-muted);
    border-radius: 12px;
    overflow: hidden;
    margin-top: -4px;
    margin-bottom: 4px;
}

.uip-more-item {
    width: 100%;
    height: 64px;
    font-size: 26px;
    background-color: transparent;
    color: var(--lpw-text);
    border-width: 0;
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
    border-radius: 0;
}

.uip-more-item--danger {
    color: var(--lpw-danger-text);
}
