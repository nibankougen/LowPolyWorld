.overlay-hidden {
    display: none;
}

.notif-panel {
    position: absolute;
    top: 40px;
    right: 0;
    width: 520px;
    max-height: 1000px;
    background-color: var(--lpw-surface);
    border-radius: 16px;
    border-width: 1px;
    border-color: var(--lpw-border);
    overflow: hidden;
}

.notif-header {
    flex-direction: row;
    align-items: center;
    padding: 20px 24px 16px 24px;
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.notif-title {
    flex-grow: 1;
    color: var(--lpw-text);
    font-size: 30px;
    -unity-font-style: bold;
}

.btn-mark-all {
    background-color: transparent;
    color: var(--lpw-accent-text);
    font-size: 22px;
    border-width: 0;
    padding: 4px 8px;
    margin-right: 8px;
}

.btn-close {
    width: 52px;
    height: 52px;
    background-color: var(--lpw-surface-sunken);
    color: var(--lpw-text-secondary);
    font-size: 28px;
    border-radius: 8px;
    border-width: 0;
}

.notif-list {
    max-height: 900px;
}

.notif-row {
    flex-direction: row;
    align-items: center;
    padding: 16px 20px;
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.notif-row--unread {
    background-color: var(--lpw-accent-subtle);
}

.notif-icon {
    width: 44px;
    height: 44px;
    font-size: 28px;
    -unity-text-align: middle-center;
    margin-right: 14px;
    flex-shrink: 0;
}

.notif-body {
    flex-grow: 1;
    color: var(--lpw-text);
    font-size: 24px;
    white-space: normal;
}

.notif-body--read {
    color: var(--lpw-text-muted);
}

.notif-time {
    color: var(--lpw-text-muted);
    font-size: 20px;
    margin-left: 10px;
    flex-shrink: 0;
}

.notif-empty {
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
}

.notif-empty-label {
    color: var(--lpw-text-muted);
    font-size: 26px;
}
