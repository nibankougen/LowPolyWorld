.overlay-hidden {
    display: none;
}

.screen-root {
    flex-grow: 1;
    background-color: var(--lpw-bg-page);
}

.screen-header {
    flex-direction: row;
    align-items: center;
    padding: 20px 16px 12px 16px;
    background-color: var(--lpw-surface);
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.btn-back {
    width: 60px;
    height: 60px;
    background-color: transparent;
    color: var(--lpw-accent-text);
    font-size: 36px;
    border-width: 0;
}

.screen-title {
    flex-grow: 1;
    color: var(--lpw-text);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.loading-state {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.loading-label {
    color: var(--lpw-text-muted);
    font-size: 26px;
}

.world-list {
    flex-grow: 1;
}

.world-row {
    flex-direction: row;
    align-items: center;
    padding: 16px 20px;
    border-bottom-width: 1px;
    border-color: var(--lpw-border);
}

.world-icon {
    width: 64px;
    height: 64px;
    background-color: var(--lpw-surface-sunken);
    border-radius: 10px;
    margin-right: 16px;
    flex-shrink: 0;
}

.world-name {
    flex-grow: 1;
    color: var(--lpw-text);
    font-size: 26px;
    -unity-font-style: bold;
    white-space: normal;
}

.btn-unhide {
    height: 56px;
    font-size: 22px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--lpw-accent);
    background-color: transparent;
    color: var(--lpw-accent-text);
    padding: 0 16px;
    margin-left: 8px;
    flex-shrink: 0;
}

.empty-state {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
}

.empty-label {
    color: var(--lpw-text-muted);
    font-size: 26px;
}
