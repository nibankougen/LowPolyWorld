.avatar-edit-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: var(--lpw-bg-page);
}

.preview-area {
    flex-grow: 1;
    position: relative;
}

.preview-render {
    width: 100%;
    height: 100%;
}

/* 3D プレビューの上に浮くフローティング戻るボタン。視認性のため暗い半透明を維持。 */
.btn-back {
    position: absolute;
    top: 12px;
    left: 12px;
    width: 44px;
    height: 44px;
    font-size: 18px;
    background-color: rgba(0,0,0,0.5);
    color: white;
    border-radius: 22px;
    border-width: 0;
}

.bottom-panel {
    flex-direction: column;
    background-color: var(--lpw-surface);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    max-height: 55%;
}

.panel-header {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px 4px;
    justify-content: space-between;
}

.undo-redo-row {
    flex-direction: row;
}

.btn-undo-redo {
    width: 36px;
    height: 36px;
    font-size: 16px;
    background-color: var(--lpw-surface-sunken);
    color: var(--lpw-text-secondary);
    border-radius: 4px;
    border-width: 0;
    margin-right: 4px;
}

.btn-undo-redo:disabled {
    opacity: 0.3;
}

.tab-row {
    flex-direction: row;
    flex-grow: 1;
    justify-content: center;
}

.edit-tab {
    padding: 6px 16px;
    background-color: transparent;
    color: var(--lpw-text-secondary);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    font-size: 14px;
}

.edit-tab--active {
    color: var(--lpw-text);
    border-bottom-color: var(--lpw-accent);
}

.btn-minimize {
    width: 36px;
    height: 36px;
    background-color: transparent;
    color: var(--lpw-text-secondary);
    border-width: 0;
    font-size: 14px;
}

.tab-content {
    flex-grow: 1;
    overflow: hidden;
}

.content-texture {
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
}

.content-accessory {
    flex-grow: 1;
    padding: 8px;
}

.edit-tab-content--hidden {
    display: none;
}

.sub-tab-row {
    flex-direction: row;
    margin-bottom: 8px;
}

.edit-subtab {
    flex-grow: 1;
    padding: 4px 0;
    background-color: transparent;
    color: var(--lpw-text-muted);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    font-size: 12px;
}

.edit-subtab--active {
    color: var(--lpw-text);
    border-bottom-color: var(--lpw-accent);
}

.accessory-grid {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
}

/* ================================================================
   サブタブコンテンツ
   ================================================================ */

.subtab-content {
    flex-grow: 1;
    flex-direction: column;
    padding: 4px;
}

.subtab-content--hidden {
    display: none;
}

/* 保存・編集 / デフォルトタブのグリッドレイアウト（flex-direction: column を上書き） */
.subtab-content--grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 4px;
}

/* ================================================================
   アクセサリスロット（利用中タブ）
   ================================================================ */

.accessory-slots {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 4px 0;
}

.accessory-slot-card {
    width: 64px;
    height: 64px;
    background-color: var(--lpw-surface-sunken);
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--lpw-border);
    margin: 4px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.accessory-slot-card--selected {
    border-color: var(--lpw-accent);
    border-width: 2px;
    background-color: var(--lpw-accent-subtle);
}

.accessory-slot-card--empty {
    border-style: dashed;
    border-color: var(--lpw-border);
}

.accessory-slot-thumb {
    width: 48px;
    height: 48px;
    border-radius: 4px;
    background-color: var(--lpw-surface-sunken);
}

.accessory-slot-check {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: var(--lpw-accent);
    color: var(--lpw-text-on-accent);
    font-size: 10px;
    -unity-text-align: middle-center;
    display: none;
}

.accessory-slot-check--visible {
    display: flex;
}

.accessory-slot-empty-icon {
    font-size: 24px;
    color: var(--lpw-text-muted);
    -unity-text-align: middle-center;
}

.accessory-slot-empty-icon--hidden {
    display: none;
}

/* ================================================================
   アクセサリ選択詳細パネル
   ================================================================ */

.accessory-selection-detail {
    flex-direction: column;
    padding: 8px 4px 4px;
    border-top-width: 1px;
    border-top-color: var(--lpw-border);
    margin-top: 4px;
}

.accessory-detail--hidden {
    display: none;
}

.accessory-bone-dropdown {
    margin-bottom: 6px;
    color: var(--lpw-text);
    font-size: 12px;
}

.accessory-bone-dropdown > Label {
    color: var(--lpw-text-muted);
    font-size: 12px;
    min-width: 36px;
}

.accessory-transform-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.accessory-transform-label {
    color: var(--lpw-text-muted);
    font-size: 11px;
    min-width: 44px;
}

.accessory-transform-field {
    flex-grow: 1;
    font-size: 11px;
    color: var(--lpw-text);
    margin-right: 4px;
    max-width: 60px;
}

.btn-remove-accessory {
    margin-top: 6px;
    height: 34px;
    background-color: var(--lpw-danger-subtle);
    color: var(--lpw-danger-text);
    border-width: 1px;
    border-color: var(--lpw-danger);
    border-radius: 6px;
    font-size: 12px;
}

/* ================================================================
   アクセサリグリッドアイテム（保存・編集 / デフォルトタブ）
   ================================================================ */

.accessory-grid-item {
    width: 64px;
    height: 80px;
    background-color: var(--lpw-surface-sunken);
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--lpw-border);
    margin: 4px;
    align-items: center;
    padding-top: 4px;
}

.accessory-grid-item-thumb {
    width: 52px;
    height: 52px;
    border-radius: 4px;
    background-color: var(--lpw-surface-sunken);
}

.accessory-grid-item-label {
    font-size: 9px;
    color: var(--lpw-text-muted);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    -unity-text-overflow-position: end;
    max-width: 60px;
    margin-top: 2px;
}

/* ================================================================
   D&D ドロップゾーン（3D プレビューオーバーレイ）
   ================================================================ */

.dnd-drop-zone {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--lpw-accent-subtle);
    border-width: 3px;
    border-color: var(--lpw-accent);
    align-items: center;
    justify-content: center;
}

.dnd-drop-zone--hidden {
    display: none;
}

.dnd-drop-label {
    color: var(--lpw-text-on-accent);
    font-size: 14px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

/* ================================================================
   D&D ドラッグゴースト
   ================================================================ */

.dnd-drag-ghost {
    position: absolute;
    width: 64px;
    height: 64px;
    background-color: var(--lpw-surface);
    border-radius: 8px;
    border-width: 2px;
    border-color: var(--lpw-accent);
    opacity: 0.85;
    align-items: center;
    justify-content: center;
}

.dnd-drag-ghost--hidden {
    display: none;
}

.dnd-ghost-label {
    font-size: 10px;
    color: var(--lpw-text-secondary);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
}

/* ================================================================
   スタブラベル
   ================================================================ */

.stub-label {
    color: var(--lpw-text-muted);
    font-size: 12px;
    -unity-text-align: middle-center;
    padding: 20px;
}

/* ================================================================
   テクスチャペイント UI
   ================================================================ */

/* メイン作業エリア */
.paint-main {
    flex-grow: 1;
    flex-direction: row;
    overflow: hidden;
}

/* 左: ブラシサイズバー */
.paint-left-bar {
    width: 40px;
    flex-direction: column;
    align-items: center;
    padding: 4px 2px;
    background-color: var(--lpw-surface-muted);
}

.brush-size-slider {
    flex-grow: 1;
    width: 20px;
}

.brush-size-label {
    color: var(--lpw-text-secondary);
    font-size: 10px;
    margin-top: 2px;
    -unity-text-align: middle-center;
}

/* 中央: キャンバスコンテナ。ペイントワークスペース背景は色判断のため中間グレーを維持。 */
.paint-canvas-container {
    flex-grow: 1;
    background-color: rgb(50, 50, 50);
    overflow: hidden;
    align-items: center;
    justify-content: center;
}

/* ペイントキャンバス本体（作品そのもの。白地を維持）。 */
.paint-canvas {
    width: 256px;
    height: 256px;
    background-color: rgb(255, 255, 255);
}

/* 右: ツールバー */
.paint-toolbar {
    width: 44px;
    flex-direction: column;
    align-items: center;
    padding: 4px 2px;
    background-color: var(--lpw-surface-muted);
}

.tool-btn {
    width: 36px;
    height: 36px;
    font-size: 16px;
    background-color: transparent;
    color: var(--lpw-text-secondary);
    border-width: 0;
    border-radius: 6px;
    margin-bottom: 2px;
    -unity-text-align: middle-center;
}

.tool-btn--active {
    background-color: var(--lpw-accent-subtle);
    color: var(--lpw-accent-text);
}

.tool-separator {
    height: 1px;
    width: 28px;
    background-color: var(--lpw-border);
    margin: 4px 4px;
}

/* 下: ペイントボトムバー */
.paint-bottom-bar {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    background-color: var(--lpw-surface-muted);
    border-top-width: 1px;
    border-top-color: var(--lpw-border);
    height: 44px;
}

/* 現在のペイント色プレビュー（色はコードが動的設定）。 */
.color-swatch {
    width: 32px;
    height: 32px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--lpw-border);
    background-color: rgb(255, 0, 0);
    margin-right: 8px;
}

.tool-hint-label {
    color: var(--lpw-text-muted);
    font-size: 12px;
    margin-right: 8px;
}

.antialias-toggle {
    color: var(--lpw-text-muted);
    font-size: 11px;
    margin-right: 8px;
}

.spacer {
    flex-grow: 1;
}

.btn-paint-save {
    padding: 6px 16px;
    background-color: var(--lpw-accent);
    color: var(--lpw-text-on-accent);
    border-width: 0;
    border-radius: 6px;
    font-size: 13px;
}

/* ================================================================
   オーバーレイパネル共通
   ================================================================ */

.overlay-panel {
    position: absolute;
    background-color: var(--lpw-surface);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--lpw-border);
    padding: 8px;
}

.paint-panel--hidden {
    display: none;
}

.overlay-panel-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.overlay-panel-title {
    flex-grow: 1;
    color: var(--lpw-text);
    font-size: 13px;
    -unity-font-style: bold;
}

.overlay-close-btn {
    width: 28px;
    height: 28px;
    background-color: transparent;
    color: var(--lpw-text-secondary);
    border-width: 0;
    font-size: 16px;
    -unity-text-align: middle-center;
}

/* ================================================================
   カラーピッカーパネル
   ================================================================ */

.color-picker-panel {
    left: 44px;
    bottom: 44px;
    width: 220px;
}

.color-wheel-area {
    align-items: center;
    margin-bottom: 8px;
}

/* 色相リング／SV スクエアは生成カラーテクスチャの下地。プレースホルダ色を維持。 */
.color-hue-ring {
    width: 180px;
    height: 180px;
    border-radius: 90px;
    align-items: center;
    justify-content: center;
    background-color: rgb(60, 60, 60);
}

.color-sv-square {
    width: 120px;
    height: 120px;
    background-color: rgb(80, 80, 80);
}

/* カラーホイール上のカーソル。任意の色の上に乗るため白枠を維持。 */
.color-cursor {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    border-width: 2px;
    border-color: white;
    background-color: transparent;
}

.picker-slider-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.picker-row-label {
    color: var(--lpw-text-secondary);
    font-size: 11px;
    width: 16px;
    -unity-text-align: middle-center;
}

.alpha-slider {
    flex-grow: 1;
    margin: 0 4px;
}

.rgba-row {
    flex-direction: row;
    margin-bottom: 8px;
}

.rgba-field {
    flex-grow: 1;
    font-size: 11px;
    color: var(--lpw-text);
    margin: 0 2px;
}

.rgba-field > Label {
    color: var(--lpw-text-muted);
    font-size: 10px;
    min-width: 10px;
}

.color-history {
    flex-direction: row;
    flex-wrap: wrap;
    width: 204px;
}

.color-history-swatch {
    width: 22px;
    height: 22px;
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--lpw-border);
    margin: 1px;
}

/* ================================================================
   レイヤーパネル
   ================================================================ */

.layer-panel {
    right: 44px;
    top: 0;
    bottom: 44px;
    width: 180px;
}

.layer-header-btn {
    padding: 2px 6px;
    background-color: var(--lpw-surface-sunken);
    color: var(--lpw-text-secondary);
    border-width: 0;
    border-radius: 4px;
    font-size: 11px;
    margin-right: 4px;
}

.layer-list {
    flex-grow: 1;
}

/* レイヤーアイテム（TexturePaintController が動的生成） */
.layer-item {
    flex-direction: column;
    padding: 0 6px;
    border-radius: 4px;
    margin-bottom: 2px;
    background-color: var(--lpw-surface-muted);
}

.layer-item--selected {
    background-color: var(--lpw-accent-subtle);
}

/* 主行（サムネ＋名前＋表示ボタン＋展開ボタン） */
.layer-item-main-row {
    flex-direction: row;
    align-items: center;
    height: 44px;
}

/* アクション行（展開時） */
.layer-item-actions {
    flex-direction: column;
    padding: 4px 0 6px 38px;
    border-top-width: 1px;
    border-top-color: var(--lpw-border);
}

.layer-item-actions--hidden {
    display: none;
}

/* 不透明度行 */
.layer-opacity-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.layer-opacity-label {
    color: var(--lpw-text-muted);
    font-size: 10px;
    width: 34px;
}

.layer-opacity-slider {
    flex-grow: 1;
    margin: 0 4px;
}

.layer-opacity-value {
    color: var(--lpw-text-secondary);
    font-size: 10px;
    width: 28px;
    -unity-text-align: middle-right;
}

/* アクションボタン行（ロック / マスク / 削除） */
.layer-action-btn-row {
    flex-direction: row;
}

.layer-action-btn {
    padding: 2px 6px;
    background-color: var(--lpw-surface-sunken);
    color: var(--lpw-text-secondary);
    border-width: 0;
    border-radius: 4px;
    font-size: 11px;
    margin-right: 4px;
    min-width: 28px;
    -unity-text-align: middle-center;
}

.layer-action-btn--active {
    background-color: var(--lpw-accent-subtle);
    color: var(--lpw-accent-text);
}

.layer-action-btn--delete {
    color: var(--lpw-danger-text);
    background-color: var(--lpw-danger-subtle);
}

/* 展開ボタン */
.layer-expand-btn {
    width: 20px;
    height: 20px;
    background-color: transparent;
    color: var(--lpw-text-muted);
    border-width: 0;
    font-size: 10px;
    -unity-text-align: middle-center;
    margin-left: 2px;
}

/* ロック中レイヤー名 */
.layer-name--locked {
    color: var(--lpw-text-muted);
}

.layer-thumb {
    width: 32px;
    height: 32px;
    border-radius: 2px;
    border-width: 1px;
    border-color: var(--lpw-border);
    margin-right: 6px;
    background-color: var(--lpw-surface-sunken);
}

.layer-name {
    flex-grow: 1;
    color: var(--lpw-text);
    font-size: 12px;
    overflow: hidden;
    -unity-text-overflow-position: end;
    white-space: nowrap;
}

.layer-visible-btn {
    width: 24px;
    height: 24px;
    background-color: transparent;
    color: var(--lpw-text-secondary);
    border-width: 0;
    font-size: 13px;
    -unity-text-align: middle-center;
}

.layer-visible-btn--hidden {
    color: var(--lpw-text-muted);
}

/* ベースレイヤー（読み取り専用） */
.layer-item--base {
    background-color: var(--lpw-surface-muted);
    opacity: 0.6;
}

/* ドラッグゴースト */
.layer-drag-ghost {
    position: absolute;
    opacity: 0.7;
    border-width: 1px;
    border-color: var(--lpw-accent);
    background-color: var(--lpw-accent-subtle);
    border-radius: 4px;
    pointer-events: none;
}

/* ドラッグ中のドロップ位置インジケーター */
.layer-drop-indicator {
    height: 2px;
    background-color: var(--lpw-accent);
    margin: 1px 0;
    pointer-events: none;
}

/* ================================================================
   その他メニューパネル
   ================================================================ */

.other-menu-panel {
    right: 44px;
    bottom: 44px;
    width: 180px;
}

.other-menu-item {
    width: 100%;
    height: 36px;
    background-color: var(--lpw-surface-sunken);
    color: var(--lpw-text);
    border-width: 0;
    border-radius: 6px;
    font-size: 12px;
    margin-bottom: 4px;
    -unity-text-align: middle-left;
    padding-left: 10px;
}

.other-menu-item:hover {
    background-color: var(--lpw-surface-active);
}

/* ================================================================
   選択範囲オーバーレイ
   ================================================================ */

.selection-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
}
