.overlay-hidden {
    display: none;
}

/* フラッシュメッセージ */
.flash-message {
    position: absolute;
    top: 80px;
    left: 0;
    right: 0;
    align-items: center;
}

.flash-label {
    background-color: var(--lpw-flash-error-bg);
    color: var(--lpw-text-on-status);
    font-size: 15px;
    padding: 10px 24px;
    border-radius: 20px;
}

/* ダイアログ共通 */
.dialog-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--lpw-scrim);
    align-items: center;
    justify-content: center;
}

.dialog-panel {
    background-color: var(--lpw-surface);
    border-radius: 16px;
    padding: 28px 24px;
    width: 300px;
    align-items: center;
}

.dialog-title {
    color: var(--lpw-text);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.dialog-message {
    color: var(--lpw-text-secondary);
    font-size: 14px;
    white-space: normal;
    -unity-text-align: upper-center;
    margin-bottom: 8px;
}

.dialog-sub {
    color: var(--lpw-text-muted);
    font-size: 12px;
    margin-bottom: 20px;
}

.dialog-btn-primary {
    width: 200px;
    height: 44px;
    background-color: var(--lpw-accent);
    color: var(--lpw-text-on-accent);
    font-size: 15px;
    border-radius: 8px;
    border-width: 0;
    margin-top: 12px;
}

.dialog-btn-secondary {
    width: 200px;
    height: 44px;
    background-color: var(--lpw-surface-sunken);
    color: var(--lpw-text-secondary);
    font-size: 15px;
    border-radius: 8px;
    border-width: 0;
    margin-top: 20px;
}
